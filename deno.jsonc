{
  "name": "@justinmchase/uffda",
  "version": "0.1.15",
  "license": "MIT",
  "exports": {
    ".": "./mod.ts"
  },
  "tasks": {
    "cli": "deno run --allow-read --allow-write --allow-env=INIT_CWD,PWD ./src/cli/main.ts",
    "compile:lang": "rm -rf ./bin && uffda compile 'src/lang/**/*.uff' --out-dir ./bin",
    "compile:cli": "deno task compile:lang && deno run --allow-read --allow-write --allow-run --allow-env ./scripts/compile-cli.ts",
    "test": "deno task compile:lang && deno test --allow-read --allow-write --parallel",
    "test:watch": "deno task compile:lang && deno test --allow-read --allow-write --watch --parallel",
    "pre": "deno fmt && deno lint --fix && deno task test && npx jsr publish --dry-run --allow-dirty"
  },
  "imports": {
    "@justinmchase/serializable": "jsr:@justinmchase/serializable@^0.3.13",
    "@justinmchase/type": "jsr:@justinmchase/type@^0.2.4",
    "@std/assert": "jsr:@std/assert@^1.0.10",
    "@std/crypto": "jsr:@std/crypto@^1.0.3",
    "@std/encoding": "jsr:@std/encoding@^1.0.6",
    "@std/fs": "jsr:@std/fs@^1.0.19",
    "@std/path": "jsr:@std/path@^1.0.8",
    "@tui/inputs": "jsr:@tui/inputs@0.0.1",
    "@tui/nice": "jsr:@tui/nice@0.6.1",
    "@tui/signals": "jsr:@tui/signals@0.0.10",
    "@tui/tui": "jsr:@tui/tui@3.0.0-dev.10"
  },
  "fmt": {
    "exclude": [
      "./src/runtime/resolvers/test.bad.module.json"
    ]
  },
  "publish": {
    // Agent docs, CI metadata, and requirement tests are not part of the library
    // export graph. Long paths under those trees also break JSR's ustar tarball
    // verify step (paths truncated near 100 chars → "not found in the tarball").
    "exclude": [
      ".agents/",
      ".cursor/",
      ".github/",
      "src/requirements/"
    ]
  }
}
