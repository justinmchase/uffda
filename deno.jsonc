{
  "name": "@justinmchase/uffda",
  "version": "0.10.8",
  "license": "MIT",
  "exports": {
    ".": "./mod.ts",
  },
  "publish": {
    // Grammar + cutover-stub package only (Rust owns the CLI/runtime).
    // `bin/` is gitignored — include it and un-ignore with `!bin/` so Publish
    // can ship compiled ModuleDeclarations after `uffda compile`. Keep the set
    // small so JSR upload/provenance finishes reliably.
    "include": [
      "mod.ts",
      "uffda.jsonc",
      "README.md",
      "src/lang/**/*.uff",
      "bin",
    ],
    "exclude": ["!bin/"],
  },
}
