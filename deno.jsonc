{
  "name": "@justinmchase/uffda",
  "version": "0.9.0",
  "license": "MIT",
  "exports": {
    ".": "./mod.ts"
  },
  "tasks": {
    "cli": "deno run --allow-read --allow-write --allow-net --allow-run --allow-env=INIT_CWD,PWD,HOME,XDG_CACHE_HOME,XDG_RUNTIME_DIR,LOCALAPPDATA ./src/cli/main.ts",
    "compile:lang": "rm -rf ./bin && uffda compile 'src/lang/**/*.uff'",
    "compile:cli": "deno task compile:lang && deno run --allow-read --allow-write --allow-run --allow-env ./scripts/compile-cli.ts",
    "test": "deno task compile:lang && deno test --allow-read --allow-write --allow-net=127.0.0.1 --allow-env=XDG_RUNTIME_DIR,HOME,XDG_CACHE_HOME,LOCALAPPDATA --parallel --ignore=test/integration/",
    "test:watch": "deno task compile:lang && deno test --allow-read --allow-write --allow-net=127.0.0.1 --allow-env=XDG_RUNTIME_DIR,HOME,XDG_CACHE_HOME,LOCALAPPDATA --watch --parallel --ignore=test/integration/",
    "test:integration": "deno task compile:lang && deno test --allow-read --allow-write --allow-run=deno --allow-net=127.0.0.1 --allow-env=XDG_RUNTIME_DIR,HOME,XDG_CACHE_HOME,LOCALAPPDATA --parallel test/integration/",
    "bench": "deno bench --allow-read --allow-write test/bench/",
    "bench:memo": "deno run --allow-read --allow-write test/bench/memo-eviction.report.ts",
    "perf": "deno task compile:lang && deno run --allow-read --allow-write --allow-env=GITHUB_STEP_SUMMARY test/perf/morse-compile.report.ts",
    "fmt:uff": "deno task compile:lang && deno task cli fmt",
    "pre": "deno fmt && deno task fmt:uff && deno lint --fix && deno task test && npx jsr publish --dry-run --allow-dirty"
  },
  "imports": {
    "@modelcontextprotocol/sdk/server/mcp.js": "npm:@modelcontextprotocol/sdk@1.30.0/server/mcp.js",
    "@modelcontextprotocol/sdk/server/stdio.js": "npm:@modelcontextprotocol/sdk@1.30.0/server/stdio.js",
    "@modelcontextprotocol/sdk/client/index.js": "npm:@modelcontextprotocol/sdk@1.30.0/client/index.js",
    "@modelcontextprotocol/sdk/inMemory.js": "npm:@modelcontextprotocol/sdk@1.30.0/inMemory.js",
    "@modelcontextprotocol/sdk/types.js": "npm:@modelcontextprotocol/sdk@1.30.0/types.js",
    "vscode-languageserver/node": "npm:vscode-languageserver@9.0.1/node.js",
    "vscode-languageserver/server": "npm:vscode-languageserver@9.0.1/lib/common/server.js",
    "vscode-languageserver-types": "npm:vscode-languageserver-types@3.17.5",
    "zod": "npm:zod@3",
    "@justinmchase/serializable": "jsr:@justinmchase/serializable@^0.3.13",
    "@justinmchase/type": "jsr:@justinmchase/type@^0.2.4",
    "@std/assert": "jsr:@std/assert@^1.0.10",
    "@std/crypto": "jsr:@std/crypto@^1.0.3",
    "@std/data-structures": "jsr:@std/data-structures@^1.1.0",
    "@std/encoding": "jsr:@std/encoding@^1.0.6",
    "@std/fs": "jsr:@std/fs@^1.0.19",
    "@std/jsonc": "jsr:@std/jsonc@^1.0.2",
    "@std/path": "jsr:@std/path@^1.0.8",
    "@std/semver": "jsr:@std/semver@^1.0.8",
    "@tui/inputs": "jsr:@tui/inputs@0.0.1",
    "@tui/nice": "jsr:@tui/nice@0.6.1",
    "@tui/signals": "jsr:@tui/signals@0.0.10",
    "@tui/tui": "jsr:@tui/tui@3.0.0-dev.10"
  },
  "fmt": {
    "exclude": [
      "./src/runtime/resolvers/test.bad.module.json",
      "./editors/vscode/"
    ]
  },
  "lint": {
    "exclude": [
      "./editors/vscode/"
    ]
  },
  "publish": {
    // Agent docs, CI metadata, tests, and tooling are not part of the library
    // export graph. Long paths under those trees also break JSR's ustar tarball
    // verify step (paths truncated near 100 chars → "not found in the tarball").
    // `bin/` is gitignored but published: the Publish workflow compiles the
    // language ModuleDeclaration JSON into it (`deno task compile:lang`) first.
    "exclude": [
      "!bin/",
      ".agents/",
      ".cursor/",
      ".github/",
      ".vscode/",
      "test/",
      "scripts/",
      "src/requirements/",
      "editors/",
      "**/*.test.ts",
      "src/test.ts",
      "src/testing.ts",
      "src/runtime/resolvers/test*.module.*"
    ]
  }
}
