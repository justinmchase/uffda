{
  "name": "@justinmchase/uffda",
  "version": "0.10.6",
  "license": "MIT",
  "exports": {
    ".": "./mod.ts"
  },
  "tasks": {
    "cli": "cargo run --locked --release --manifest-path rust/Cargo.toml --features embed-languages --bin uffda --",
    "compile:lang": "rm -rf ./bin && uffda compile 'src/lang/**/*.uff'",
    "compile:cli": "deno task compile:lang && cargo build --locked --release --manifest-path rust/Cargo.toml --features embed-languages --bin uffda",
    "test": "deno task compile:lang && cargo xtask test && deno task test:tools",
    "test:tools": "deno test --allow-read --allow-write scripts/ .github/actions/uffda-setup/",
    "fmt:uff": "deno task compile:lang && deno task cli fmt 'src/lang/**/*.uff' 'examples/**/*.uff'",
    "pre": "deno fmt && deno task fmt:uff && deno lint && cargo xtask check && deno task test:tools && deno publish --dry-run --allow-dirty"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.10",
    "@std/path": "jsr:@std/path@^1.0.8"
  },
  "fmt": {
    "exclude": [
      "./.tmp/",
      "./editors/vscode/"
    ]
  },
  "lint": {
    "exclude": [
      "./editors/vscode/",
      "./.tmp/"
    ]
  },
  "publish": {
    // Grammar + cutover-stub package only (Rust owns the CLI/runtime).
    // `bin/` is gitignored — include it and un-ignore with `!bin/` so Publish
    // can ship compiled ModuleDeclarations after `uffda compile`. Keep the set
    // small so JSR upload/provenance finishes reliably.
    "include": [
      "mod.ts",
      "uffda.jsonc",
      "README.md",
      "src/lang/**/*.uff",
      "bin"
    ],
    "exclude": [
      "!bin/"
    ]
  }
}
