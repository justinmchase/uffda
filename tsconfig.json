{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "scripts/**/*.ts",
    ".github/actions/uffda-setup/**/*.ts",
    "tests/perf/**/*.ts"
  ],
  "exclude": ["editors/vscode", "node_modules", ".tmp", "target"]
}
