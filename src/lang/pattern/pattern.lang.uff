# PatternLang pipelines Source → tokens → PatternComplete.
import "../source/mod.uff" Source;
import "../tokenizer/mod.uff" TokenizerNoWhitespace;
import "./pattern.uff" Pattern;

export PatternLang;
export PatternTokens;

# Input left over after the pattern is a recovery point.
rule PatternComplete = p:Pattern ope end sneak by skip any* -> p;

rule PatternTokens = [PatternComplete];

rule PatternLang =
  |> Source
  |> [TokenizerNoWhitespace]
  |> [PatternComplete]
;
