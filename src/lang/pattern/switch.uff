# Switch matches `switch { key: Pattern, ..., default: Pattern }` for
# committed-choice dispatch (see runtime/patterns/switch.ts). Each case key is a
# fixed, author-declared literal-value set and/or a CharacterClass — never a
# general Pattern — so dispatch is a direct check, not inference. `default` is a
# reserved case marker (see ReservedKeyword in resolve.uff) and, if present,
# must be the last entry. Case keys use AtomicLiteralSource / ContextualValue
# (not the full Literal, which also allows bare identifiers) so a bare `default`
# can never be mistaken for a case key.
import "./pattern.uff" Pattern;
import "./character_class.uff" CharacterClass;
import "./literals.uff" ContextualValue AtomicLiteralSource;
import "../editor/editor.uff" Keyword Documentation;

export Switch;

rule SwitchCaseKeyValue =
  | ContextualValue
  | AtomicLiteralSource
;

rule SwitchCaseKeyValueTail = "," v:SwitchCaseKeyValue -> v;

rule SwitchCaseKeyValues =
  f:SwitchCaseKeyValue r:SwitchCaseKeyValueTail*
  -> { kind: "values", values: (flat (pack f r)) }
;

rule SwitchCaseKeyCharacterClass =
  c:CharacterClass
  -> { kind: "characterClass", characterClass: c.characterClass }
;

rule SwitchCaseKey =
  | SwitchCaseKeyCharacterClass
  | SwitchCaseKeyValues
;

[Documentation {
  description: "The `:` between a switch case's values and its pattern.",
  error: "Each switch case is its values, `:`, and its pattern, as in `switch \{ \"a\": A, default: B }`."
}]
rule SwitchCaseColon = ":";

rule SwitchCase =
  k:SwitchCaseKey SwitchCaseColon p:Pattern
  -> { key: k, pattern: p }
;

rule SwitchCaseTail = "," c:SwitchCase -> c;

rule SwitchCases = f:SwitchCase r:SwitchCaseTail* -> (flat (pack f r));

[Keyword]
rule DefaultKeyword = "default";

rule SwitchDefaultCase = DefaultKeyword SwitchCaseColon p:Pattern -> p;

rule SwitchCasesWithDefaultBody =
  c:SwitchCases "," d:SwitchDefaultCase
  -> { cases: c, default: d }
;

rule SwitchDefaultOnlyBody = d:SwitchDefaultCase -> { cases: [], default: d };

rule SwitchCasesOnlyBody = c:SwitchCases -> { cases: c, default: undefined };

rule SwitchEmptyBody = ok -> { cases: [], default: undefined };

rule SwitchBody =
  | SwitchCasesWithDefaultBody
  | SwitchDefaultOnlyBody
  | SwitchCasesOnlyBody
  | SwitchEmptyBody
;

[Keyword]
rule SwitchKeyword = "switch";

[Documentation {
  description: "The `}` that ends a switch.",
  error: "Expected `}` here to close the switch, or `,` before its next case."
}]
rule SwitchEnd = "}";

rule Switch =
  SwitchKeyword "{" b:SwitchBody ","? SwitchEnd
  -> { kind: "switch", cases: b.cases, default: b.default }
;
