# Or matches And patterns joined by `|` as an Or AST. Optional leading `|` is
# allowed, unless it begins a leading `|>`. Uses std one for length-1 collapse
# (B4).
import "./and.uff" And;

export Or;

rule OrTail = "|" a:And -> a;

rule Or =
  ("|" not ">")?
  o:(And OrTail* -> (one (flat _) { kind: "or", patterns: (flat _) }))
  -> o
;
