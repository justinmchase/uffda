# Prefix operators, capture, and postfix repetition (* / + / ?). Star bounds are
# separate arms (B8). Digit StarMinMax requires max >= min via BoundNum |>
# (number & $n..) (open-upper between). Variable bounds still rely on Quantifier
# runtime. Avoid capture names min/max/name — they fail to parse.
import "./atomic.uff" Atomic;
import "./pattern.uff" Pattern;
import "../common/identifier.uff" IdToken;
import "../expression/number.uff" Number;
import "../editor/editor.uff" Keyword Documentation;

export Prefix;
export Star;

rule BoundNum = n:Number -> n.value;

rule NonNegNum =
  |> BoundNum
  |> (number & 0..)
;

rule BoundLiteral = n:NonNegNum -> { kind: "value.literal", value: n };

rule BoundVariable = "$" n:IdToken -> { kind: "value.variable", name: n };

[Documentation {
  description: "A repetition bound.",
  error: "A repetition bound is a non-negative number or a `$variable`, as in `a*2..5` or `a*..$n`."
}]
rule Bound =
  | BoundVariable
  | BoundLiteral
;

rule StarMinMaxNumNum =
  p:Atomic "*" n:NonNegNum "." "." m:(BoundNum |> (number & $n..))
  -> {
    kind: "quantifier",
    pattern: p,
    min: { kind: "value.literal", value: n },
    max: { kind: "value.literal", value: m }
  }
;

rule StarMinMaxVarVar =
  p:Atomic "*" n:BoundVariable "." "." m:BoundVariable
  -> { kind: "quantifier", pattern: p, min: n, max: m }
;

rule StarMinMaxNumVar =
  p:Atomic "*" n:BoundLiteral "." "." m:BoundVariable
  -> { kind: "quantifier", pattern: p, min: n, max: m }
;

rule StarMinMaxVarNum =
  p:Atomic "*" n:BoundVariable "." "." m:BoundLiteral
  -> { kind: "quantifier", pattern: p, min: n, max: m }
;

rule StarMinMax =
  | StarMinMaxNumNum
  | StarMinMaxVarVar
  | StarMinMaxNumVar
  | StarMinMaxVarNum
;

rule StarMinOpen =
  p:Atomic "*" n:Bound "." "." not Bound
  -> { kind: "quantifier", pattern: p, min: n, max: undefined }
;

rule StarMaxOnly =
  p:Atomic "*" "." "." m:Bound
  -> {
    kind: "quantifier",
    pattern: p,
    min: { kind: "value.literal", value: 0 },
    max: m
  }
;

rule StarMinOnly =
  p:Atomic "*" n:Bound not ("." ".")
  -> { kind: "quantifier", pattern: p, min: n, max: undefined }
;

rule StarBare =
  p:Atomic "*" not Bound not "."
  -> { kind: "quantifier", pattern: p, min: undefined, max: undefined }
;

rule Star =
  | StarMinMax
  | StarMinOpen
  | StarMaxOnly
  | StarMinOnly
  | StarBare
;

rule Plus =
  p:Atomic "+"
  -> {
    kind: "quantifier",
    pattern: p,
    min: { kind: "value.literal", value: 1 },
    max: undefined
  }
;

rule Optional = p:Atomic "?" -> { kind: "maybe", pattern: p };

rule Postfix =
  | Star
  | Plus
  | Optional
  | Atomic
;

[Keyword]
rule NotKeyword = "not";

rule Not = NotKeyword p:Prefix -> { kind: "not", pattern: p };

[Keyword]
rule MaybeKeyword = "maybe";

rule Maybe = MaybeKeyword p:Prefix -> { kind: "maybe", pattern: p };

[Keyword]
rule LookaheadKeyword = "lookahead";

rule Lookahead = LookaheadKeyword p:Prefix -> { kind: "lookahead", pattern: p };

[Documentation {
  description: "The `]` that ends an `into` pattern.",
  error: "Expected `]` here to close the pattern that starts with `[`."
}]
rule IntoEnd = "]";

rule Into = "[" p:Pattern IntoEnd -> { kind: "into", pattern: p };

[Keyword]
rule ExceptKeyword = "except";

rule Except = ExceptKeyword p:Prefix -> { kind: "except", pattern: p };

[Keyword]
rule SkipKeyword = "skip";

rule Skip = SkipKeyword p:Prefix -> { kind: "skip", pattern: p };

rule SkipAny =
  SkipKeyword not Prefix
  -> { kind: "skip", pattern: { kind: "any" } }
;

[Keyword]
rule OpeKeyword = "ope";

[Keyword]
rule SneakKeyword = "sneak";

[Keyword]
rule ByKeyword = "by";

[Keyword]
rule UntilKeyword = "until";

# `sneak by until T` skips one or more items up to, but not including, `T`, so a
# recovery never swallows its parent's terminator.
rule SneakByUntil =
  UntilKeyword t:Prefix
  -> {
    kind: "quantifier",
    pattern: {
      kind: "then",
      patterns: [{ kind: "not", pattern: t } { kind: "any" }]
    },
    min: { kind: "value.literal", value: 1 },
    max: undefined
  }
;

[Documentation {
  description: "The pattern that skips input after a recovery point fails.",
  error: "`sneak by` must be followed by the pattern that skips the input after a failure, as in `ope Item sneak by skip any`."
}]
rule SneakBy =
  | SneakByUntil
  | Prefix
;

[Documentation {
  description: "The `sneak by` of a recovery point.",
  error: "`ope` and its pattern must be followed by `sneak by` and the pattern that skips the input after a failure, as in `ope Item sneak by skip any`."
}]
rule OpeSneakBy = SneakKeyword ByKeyword;

# `ope P sneak by S` is a recovery point: when `P` fails with recovery enabled,
# `S` skips the erroneous input instead.
rule Ope =
  OpeKeyword p:Prefix OpeSneakBy s:SneakBy
  -> { kind: "recover", pattern: p, skip: s }
;

rule Capture =
  n:IdToken ":" p:Prefix
  -> { kind: "variable", name: n, pattern: p }
;

[Documentation {
  description: "One pattern of a sequence, with its prefix operators and repetition.",
  error: "Expected a pattern here, such as a rule name, a quoted string, `any`, or a group in `(…)`."
}]
rule Prefix =
  | Not
  | Maybe
  | Lookahead
  | Into
  | Except
  | Skip
  | SkipAny
  | Ope
  | Capture
  | Postfix
;
