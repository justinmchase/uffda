# Prefix operators, capture, and postfix repetition (* / + / ?).
# Star bounds are separate arms (B8). Digit StarMinMax requires max >= min via
# BoundNum |> (number & $n..) (open-upper between). Variable bounds still rely
# on Quantifier runtime. Avoid capture names min/max/name — they fail to parse.
import "./atomic.uff" Atomic;
import "./pattern.uff" Pattern;
import "../common/identifier.uff" IdToken;
import "../expression/number.uff" Number;

export Prefix;
export Star;

rule BoundNum =
  n:Number -> n.value;

rule NonNegNum =
  BoundNum |> (number & 0..);

rule BoundLiteral =
  n:NonNegNum -> { kind: "value.literal", value: n };

rule BoundVariable =
  "$"
  n:IdToken
  -> { kind: "value.variable", name: n };

rule Bound =
  | BoundVariable
  | BoundLiteral
  ;

rule StarMinMaxNumNum =
  p:Atomic
  "*"
  n:NonNegNum
  "."
  "."
  m:(BoundNum |> (number & $n..))
  -> {
    kind: "quantifier",
    pattern: p,
    min: { kind: "value.literal", value: n },
    max: { kind: "value.literal", value: m }
  };

rule StarMinMaxVarVar =
  p:Atomic
  "*"
  n:BoundVariable
  "."
  "."
  m:BoundVariable
  -> { kind: "quantifier", pattern: p, min: n, max: m };

rule StarMinMaxNumVar =
  p:Atomic
  "*"
  n:BoundLiteral
  "."
  "."
  m:BoundVariable
  -> { kind: "quantifier", pattern: p, min: n, max: m };

rule StarMinMaxVarNum =
  p:Atomic
  "*"
  n:BoundVariable
  "."
  "."
  m:BoundLiteral
  -> { kind: "quantifier", pattern: p, min: n, max: m };

rule StarMinMax =
  | StarMinMaxNumNum
  | StarMinMaxVarVar
  | StarMinMaxNumVar
  | StarMinMaxVarNum
  ;

rule StarMinOpen =
  p:Atomic
  "*"
  n:Bound
  "."
  "."
  not Bound
  -> {
    kind: "quantifier",
    pattern: p,
    min: n,
    max: undefined
  };

rule StarMaxOnly =
  p:Atomic
  "*"
  "."
  "."
  m:Bound
  -> {
    kind: "quantifier",
    pattern: p,
    min: { kind: "value.literal", value: 0 },
    max: m
  };

rule StarMinOnly =
  p:Atomic
  "*"
  n:Bound
  not ("." ".")
  -> {
    kind: "quantifier",
    pattern: p,
    min: n,
    max: undefined
  };

rule StarBare =
  p:Atomic
  "*"
  not Bound
  not "."
  -> { kind: "quantifier", pattern: p, min: undefined, max: undefined };

rule Star =
  | StarMinMax
  | StarMinOpen
  | StarMaxOnly
  | StarMinOnly
  | StarBare
  ;

rule Plus =
  p:Atomic
  "+"
  -> {
    kind: "quantifier",
    pattern: p,
    min: { kind: "value.literal", value: 1 },
    max: undefined
  };

rule Optional =
  p:Atomic
  "?"
  -> { kind: "maybe", pattern: p };

rule Postfix =
  | Star
  | Plus
  | Optional
  | Atomic
  ;

rule Not =
  "not"
  p:Prefix
  -> { kind: "not", pattern: p };

rule Maybe =
  "maybe"
  p:Prefix
  -> { kind: "maybe", pattern: p };

rule Lookahead =
  "lookahead"
  p:Prefix
  -> { kind: "lookahead", pattern: p };

rule Into =
  "["
  p:Pattern
  "]"
  -> { kind: "into", pattern: p };

rule Except =
  "except"
  p:Prefix
  -> { kind: "except", pattern: p };

rule Capture =
  n:IdToken
  ":"
  p:Prefix
  -> { kind: "variable", name: n, pattern: p };

rule Prefix =
  | Not
  | Maybe
  | Lookahead
  | Into
  | Except
  | Capture
  | Postfix
  ;
