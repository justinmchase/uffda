# Pipe matches Then steps joined by `|>` as a Pipeline AST. Optional leading
# `|>` is allowed. Uses std one for length-1 collapse (B4).
import "./then.uff" Then;

export Pipe;

rule PipeTail = "|" ">" t:Then -> t;

rule Pipe =
  ("|" ">")?
  p:(Then PipeTail* -> (one (flat _) { kind: "pipeline", steps: (flat _) }))
  -> p
;
