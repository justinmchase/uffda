# Pipe matches Then steps joined by `|>` as a Pipeline AST. Optional leading
# `|>` is allowed. Uses std one for length-1 collapse (B4). Comment nodes before
# a `|>` are members of the step list.
import "./then.uff" Then;
import "../common/comment.uff" CommentNode;

export Pipe;

rule PipeTail = c:CommentNode* "|" ">" t:Then -> (flat [c [t]]);

rule Pipe =
  ("|" ">")? m:(f:Then r:PipeTail* -> (flat [[f] (flat r)]))
  -> (one m { kind: "pipeline", steps: m })
;
