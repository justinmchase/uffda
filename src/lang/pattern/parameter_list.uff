# ParameterList captures `<...>` (angle-bracket) content as raw balanced tokens,
# then reparses it as a Pattern via PatternTokens. This is the shared
# `<pattern>` mechanism reused by both `func` declarations (func.rules.uff) and
# inline lambda expressions (expression/lambda.uff). Omitted or empty `<>` means
# End (no arguments).
import "./pattern.lang.uff" PatternTokens;

export ParameterList;

rule ParameterEscapedQuotedTokens = "\\" e:("\"" | "{" | "\\") -> (pack "\\" e);

rule ParameterQuotedTokenContent =
  ParameterEscapedQuotedTokens | not "\"" & string
;

rule ParameterQuotedTokenSequence =
  o:"\"" c:ParameterQuotedTokenContent* e:"\""
  -> (flat (pack o (flat c) e))
;

rule ParameterChunkNestedAngle =
  o:"<" c:ParameterChunk* e:">"
  -> (flat (pack o (flat c) e))
;

rule ParameterChunkNestedParen =
  o:"(" c:ParameterChunk* e:")"
  -> (flat (pack o (flat c) e))
;

rule ParameterChunkNestedBracket =
  o:"[" c:ParameterChunk* e:"]"
  -> (flat (pack o (flat c) e))
;

rule ParameterChunkNestedBrace =
  o:"{" c:ParameterChunk* e:"}"
  -> (flat (pack o (flat c) e))
;

rule ParameterChunk =
  | ParameterQuotedTokenSequence
  | ParameterChunkNestedAngle
  | ParameterChunkNestedParen
  | ParameterChunkNestedBracket
  | ParameterChunkNestedBrace
  | not ">" & string
;

rule ParameterToken = ParameterChunk+ -> (flat _);

rule ParameterPatterns = ParameterToken |> PatternTokens;

rule ParameterList =
  "<" p:ParameterPatterns? ">"
  -> (coalesce p { kind: "end" })
;
