# Structure matches grouping `(P)` and object-like Over `{ k:P, ... }`. Named
# keys bind the field (or an `as` alias) as a variable wrapping P. Over builds
# named keys via std from_entries; ordered rest clauses can match remaining
# entries by key/value patterns or accept all leftovers with `...ope`. Cycles
# with Pattern via Atomic are expected (B9); Resolver import caching breaks
# recursion.
import "../common/identifier.uff" IdToken;
import "./pattern.uff" Pattern;
import "../editor/editor.uff" Documentation;

export Structure;

func UniqueNames<names:any> =
  (eq (length names) (length (to_set names)))
;

rule CollectEntryBinds =
  [any p:CollectPatternBinds]
  -> p
;

rule CollectNestedOvers =
  | CollectOverBinds
  | CollectProjectionBinds
  | (
    object
    & { kind: "variable", pattern: (p:CollectNestedOvers) }
    -> p
  )
  | (any -> [])
;

rule CollectVariableBinds =
  object
  & {
    kind: "variable",
    name: (n:string),
    pattern: (p:CollectNestedOvers)
  }
  -> (flat [[n] p])
;

rule CollectOverBinds =
  object
  & { kind: "over", keys: (k:object) }
  names:((ok -> [...k]) |> [e:CollectEntryBinds*] -> (flat e))
  -> names
;

rule CollectProjectionBinds =
  object
  & { kind: "projection", pattern: (p:CollectNestedOvers) }
  -> p
;

rule CollectPatternBinds =
  | CollectVariableBinds
  | CollectOverBinds
  | CollectProjectionBinds
  | (any -> [])
;

[Documentation {
  description: "The `)` that ends a group.",
  error: "Expected `)` here to close the group that starts with `(`."
}]
rule GroupEnd = ")";

rule Group = "(" p:Pattern GroupEnd -> p;

[Documentation {
  description: "The `:` between an object pattern entry's key and its pattern.",
  error: "Each entry of an object pattern is a key and optional `: pattern` or `as` alias, as in `\{ kind: \"rule\", n: number as x }`."
}]
rule OverEntryColon = ":";

rule OverEntryAsKeyword = "as";

[Documentation {
  description: "The name that receives an object field instead of the key.",
  error: "Expected a capture name after `as`."
}]
rule OverEntryAsName = IdToken;

rule OverEntryAs = OverEntryAsKeyword n:OverEntryAsName -> n;

func OverFieldBind<n:string p:any a:any> =
  {
    name: n,
    pattern: { kind: "variable", name: (coalesce a n), pattern: p }
  }
;

[Documentation {
  description: "The pattern an object field's value must match. It cannot be an ungrouped `name: pattern` capture.",
  error: "An object field cannot use an ungrouped `name: pattern` capture. Write `\{ n: number }` to bind `n`, or `\{ n: number as x }` to rename it."
}]
rule OverFieldPattern =
  not (IdToken OverEntryColon)
  p:Pattern
  -> p
;

rule OverEntryTyped =
  n:IdToken OverEntryColon p:OverFieldPattern a:OverEntryAs?
  -> (OverFieldBind n p a)
;

rule OverEntryBareAlias =
  n:IdToken a:OverEntryAs
  -> (OverFieldBind n { kind: "any" } a)
;

rule OverEntryBare =
  n:IdToken not OverEntryColon not OverEntryAsKeyword
  -> (OverFieldBind n { kind: "any" } undefined)
;

rule OverEntry =
  | OverEntryTyped
  | OverEntryBareAlias
  | OverEntryBare
;

rule OverEntryTail = "," e:OverEntry -> e;

rule OverEntries = f:OverEntry r:OverEntryTail* -> (flat (pack f r));

rule OverEntriesWithTrailing = e:OverEntries ","? -> e;

[Documentation {
  description: "The `...` that starts an object rest-entry matcher.",
  error: "Expected `...` here to start an object rest-entry matcher."
}]
rule OverRestStart = "." "." ".";

rule OverRestOpen = "[";

[Documentation {
  description: "The `]` that ends a rest key pattern.",
  error: "Expected `]` here to close the rest key pattern."
}]
rule OverRestClose = "]";

[Documentation {
  description: "The `:` between a rest key pattern and value pattern.",
  error: "Expected `:` here between the rest key pattern and value pattern."
}]
rule OverRestColon = ":";

[Documentation {
  description: "The name that captures each full entry matched by a rest clause.",
  error: "Expected a capture name after `...`."
}]
rule OverRestEntryName = IdToken;

[Documentation {
  description: "The `:` after an entry capture name.",
  error: "Expected `:` here after the rest entry capture name."
}]
rule OverRestEntryColon = ":";

rule OverRestPatternWithEntry =
  OverRestStart
  entry:OverRestEntryName
  OverRestEntryColon
  OverRestOpen
  key:Pattern
  OverRestClose
  OverRestColon
  value:Pattern
  -> { kind: "pattern", entry: entry, key: key, value: value }
;

rule OverRestPatternWithoutEntry =
  OverRestStart
  OverRestOpen
  key:Pattern
  OverRestClose
  OverRestColon
  value:Pattern
  -> { kind: "pattern", key: key, value: value }
;

rule OverRestPattern =
  | OverRestPatternWithEntry
  | OverRestPatternWithoutEntry
;

rule OverRestPatternTail = ","? rest:OverRestPattern -> rest;

rule OverRestPatterns =
  first:OverRestPattern rest:OverRestPatternTail*
  -> (flat [first rest])
;

[Documentation {
  description: "The `ope` that accepts all entries left by earlier clauses.",
  error: "Expected `ope` here to accept all remaining object entries."
}]
rule OverRestAnyKeyword = "ope";

rule OverRestAny = OverRestStart OverRestAnyKeyword -> [{ kind: "any" }];

rule OverRestPatternsWithAny =
  patterns:OverRestPatterns ","? rest:OverRestAny
  -> (flat [patterns rest])
;

rule OverRestSequenceBody =
  | OverRestPatternsWithAny
  | OverRestPatterns
  | OverRestAny
;

rule OverRestSequence = body:OverRestSequenceBody -> body;

rule OverEntriesWithRest =
  entries:OverEntries ","? rest:OverRestSequence ","?
  -> { kind: "over", keys: (from_entries (flat entries)), rest: rest }
;

rule OverRestOnly =
  rest:OverRestSequence ","?
  -> { kind: "over", keys: (from_entries []), rest: rest }
;

rule OverEntriesOnly =
  entries:OverEntriesWithTrailing
  -> { kind: "over", keys: (from_entries (flat entries)) }
;

rule OverEmpty = ok -> { kind: "over", keys: (from_entries []) };

[Documentation {
  description: "The `}` that ends an object pattern.",
  error: "Expected `}` here to close the object pattern, or `,` before its next field or `...` rest matcher."
}]
rule OverEnd = "}";

rule OverBody =
  | OverEntriesWithRest
  | OverRestOnly
  | OverEntriesOnly
  | OverEmpty
;

[Documentation {
  description: "Object pattern capture names on one matching path must be unique.",
  error: "This object pattern binds the same name more than once. Rename one field with `as`."
}]
rule UniqueObjectBinds =
  (names:any -> (UniqueNames names)) |> true
;

rule Over =
  "{"
  body:OverBody
  OverEnd
  ((ok -> body) |> CollectPatternBinds |> UniqueObjectBinds)
  -> body
;

rule Structure =
  | Group
  | Over
;
