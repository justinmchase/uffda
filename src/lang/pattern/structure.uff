# Structure matches grouping `(P)` and object-like Over `{ k:P, ... }`. Over
# builds named keys via std from_entries; ordered rest clauses can match
# remaining entries by key/value patterns or accept all leftovers with `...ope`.
# Cycles with Pattern via Atomic are expected (B9); Resolver import caching
# breaks recursion.
import "../common/identifier.uff" IdToken;
import "./pattern.uff" Pattern;
import "../editor/editor.uff" Documentation;

export Structure;

[Documentation {
  description: "The `)` that ends a group.",
  error: "Expected `)` here to close the group that starts with `(`."
}]
rule GroupEnd = ")";

rule Group = "(" p:Pattern GroupEnd -> p;

[Documentation {
  description: "The `:` between an object pattern entry's key and its pattern.",
  error: "Each entry of an object pattern is a key, `:`, and the pattern its value must match, as in `\{ kind: \"rule\" }`."
}]
rule OverEntryColon = ":";

rule OverEntry = n:IdToken OverEntryColon p:Pattern -> { name: n, pattern: p };

rule OverEntryTail = "," e:OverEntry -> e;

rule OverEntries = f:OverEntry r:OverEntryTail* -> (flat (pack f r));

rule OverEntriesWithTrailing = e:OverEntries ","? -> e;

[Documentation {
  description: "The `...` that starts an object rest-entry matcher.",
  error: "Expected `...` here to start an object rest-entry matcher."
}]
rule OverRestStart = "." "." ".";

rule OverRestOpen = "[";

[Documentation {
  description: "The `]` that ends a rest key pattern.",
  error: "Expected `]` here to close the rest key pattern."
}]
rule OverRestClose = "]";

[Documentation {
  description: "The `:` between a rest key pattern and value pattern.",
  error: "Expected `:` here between the rest key pattern and value pattern."
}]
rule OverRestColon = ":";

rule OverRestPattern =
  OverRestStart
  OverRestOpen
  key:Pattern
  OverRestClose
  OverRestColon
  value:Pattern
  -> { kind: "pattern", key: key, value: value }
;

rule OverRestPatternTail = ","? rest:OverRestPattern -> rest;

rule OverRestPatterns =
  first:OverRestPattern rest:OverRestPatternTail*
  -> (flat [first rest])
;

[Documentation {
  description: "The `ope` that accepts all entries left by earlier clauses.",
  error: "Expected `ope` here to accept all remaining object entries."
}]
rule OverRestAnyKeyword = "ope";

rule OverRestAny = OverRestStart OverRestAnyKeyword -> [{ kind: "any" }];

rule OverRestPatternsWithAny =
  patterns:OverRestPatterns ","? rest:OverRestAny
  -> (flat [patterns rest])
;

rule OverRestSequenceBody =
  | OverRestPatternsWithAny
  | OverRestPatterns
  | OverRestAny
;

rule OverRestSequence = body:OverRestSequenceBody -> body;

rule OverEntriesWithRest =
  entries:OverEntries ","? rest:OverRestSequence ","?
  -> { kind: "over", keys: (from_entries (flat entries)), rest: rest }
;

rule OverRestOnly =
  rest:OverRestSequence ","?
  -> { kind: "over", keys: (from_entries []), rest: rest }
;

rule OverEntriesOnly =
  entries:OverEntriesWithTrailing
  -> { kind: "over", keys: (from_entries (flat entries)) }
;

rule OverEmpty = ok -> { kind: "over", keys: (from_entries []) };

[Documentation {
  description: "The `}` that ends an object pattern.",
  error: "Expected `}` here to close the object pattern, or `,` before its next `key: pattern` entry or `...` rest matcher."
}]
rule OverEnd = "}";

rule OverBody =
  | OverEntriesWithRest
  | OverRestOnly
  | OverEntriesOnly
  | OverEmpty
;

rule Over = "{" body:OverBody OverEnd -> body;

rule Structure =
  | Group
  | Over
;
