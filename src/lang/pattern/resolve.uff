# Resolve matches Name or Name<Pattern…> and projects a resolve reference AST.
# Optional arg lists use flat+coalesce (B5) instead of Native unpack. Cycles
# with Pattern via Atomic are expected (B9); Resolver import caching breaks
# recursion.
import "../common/identifier.uff" IdToken;
import "./pattern.uff" Pattern;
import "../editor/editor.uff" Highlight NameReference Documentation;

export Resolve;

rule ReservedKeyword =
  | "and"
  | "any"
  | "array"
  | "bigint"
  | "boolean"
  | "date"
  | "default"
  | "end"
  | "error"
  | "except"
  | "fail"
  | "false"
  | "function"
  | "in"
  | "includes"
  | "into"
  | "lookahead"
  | "map"
  | "maybe"
  | "not"
  | "null"
  | "number"
  | "object"
  | "ok"
  | "ope"
  | "or"
  | "over"
  | "pipeline"
  | "quantifier"
  | "set"
  | "skip"
  | "sneak"
  | "string"
  | "switch"
  | "symbol"
  | "true"
  | "undefined"
  | "until"
  | "variable"
;

rule EscapedIdentifierToken = "@" n:IdToken -> n;

[NameReference { kinds: ["rule"] }]
[Highlight { role: "type" }]
rule ResolveName =
  | EscapedIdentifierToken
  | not ReservedKeyword & IdToken
;

rule ResolveArg = Pattern;

rule ResolveArgTail = "," v:ResolveArg -> v;

rule ResolveArgList = f:ResolveArg r:ResolveArgTail* ","? -> (flat (pack f r));

[Documentation {
  description: "The `>` that ends a rule's arguments.",
  error: "Expected `>` here to close the rule's arguments, or `,` before the next one."
}]
rule ResolveArgsEnd = ">";

rule ResolveArgs =
  "<" a:ResolveArgList? ResolveArgsEnd
  -> (flat (coalesce a []))
;

rule Resolve =
  n:ResolveName a:ResolveArgs?
  -> {
    kind: "resolve",
    targetKind: "reference",
    name: n,
    args: (flat (coalesce a []))
  }
;
