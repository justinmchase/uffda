# Import declaration syntax: import "specifier" Name Rest*; see
# specifier.rules.uff for the specifier forms. Variable bindings are
# single-letter (B12). `ImportModulePath` and `ImportNameEntry` exist so editor
# metadata (see ../editor/editor.uff) marks exactly the path text and each
# imported name.
import "./shared.rules.uff" IdentifierToken ImportKeyword DeclarationEnd;
import "./specifier.rules.uff" ModuleSpecifier;
import "../editor/editor.uff" Import ModulePath ImportedName Documentation;

export ImportDeclarationSyntax;
export ImportNameList;
export ImportModuleSpecifier;

[ModulePath { extensions: [".uff"] }]
rule ImportModulePath = ModuleSpecifier;

[Documentation {
  description: "The quoted path of the module an import reads.",
  error: "An import names its module with a quoted path, as in `import \"./other.uff\" Name;`."
}]
rule ImportModuleSpecifier = "\"" p:ImportModulePath ImportModulePathEnd -> p;

[Documentation {
  description: "The `\"` that ends an import's module path.",
  error: "Expected `\"` here to end the module path. A path is made of ASCII letters, digits, `_`, `.`, `-` and `/`; check for a missing closing `\"` or a character a path cannot hold."
}]
rule ImportModulePathEnd = "\"";

[ImportedName]
rule ImportNameEntry = IdentifierToken;

[Documentation {
  description: "The names an import takes from its module.",
  error: "An import lists the names it takes after the module path, as in `import \"./other.uff\" A B;`."
}]
rule ImportNameList = ImportNameEntry ImportNameEntry* -> (flat _);

[Import]
rule ImportDeclarationSyntax =
  ImportKeyword m:ImportModuleSpecifier n:ImportNameList DeclarationEnd
  -> { kind: "import", moduleUrl: m, names: n }
;
