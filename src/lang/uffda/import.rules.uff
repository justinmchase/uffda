# Import declaration syntax: import "path" Name Rest*;
# Path join uses std join (B2). Variable bindings are single-letter (B12).
# `ImportModulePath` and `ImportNameEntry` exist so editor metadata (see
# ../editor/editor.uff) marks exactly the path text and each imported name.
import "./shared.rules.uff" IdentifierToken ImportKeyword;
import "../editor/editor.uff" Import ModulePath ImportedName;

export ImportDeclarationSyntax;
export ImportNameList;
export ImportModuleSpecifier;

[ModulePath { extensions: [".uff"] }]
rule ImportModulePath =
  p:((not "\"") & string)*
  -> (join p "");

rule ImportModuleSpecifier =
  "\""
  p:ImportModulePath
  "\""
  -> p;

[ImportedName]
rule ImportNameEntry = IdentifierToken;

rule ImportNameList =
  ImportNameEntry
  ImportNameEntry*
  -> (flat _);

[Import]
rule ImportDeclarationSyntax =
  ImportKeyword
  m:ImportModuleSpecifier
  n:ImportNameList
  ";"
  -> { kind: "import", moduleUrl: m, names: n };
