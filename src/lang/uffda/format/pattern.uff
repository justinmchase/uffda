# Formats patterns. `Pattern<L>` takes a pattern node and a layout (see
# `layout.uff`) and produces its source text, adding parentheses wherever the
# pattern grammar's precedence (or its flattening of same-kind nesting) needs
# them. Projections are always parenthesized, so a nested projection is never
# cut as a rule-level projection. Comments in a list are written on their own
# lines (see `comment.uff`).
import "./layout.uff"
  Fit
  AstKind
  Indent
  Shift
  Suffix
  Inside
  Entry
  Next
  Sep
  Bracket
  List
  LineStart
  LineBreak
;
import "./comment.uff" Lead Trail;
import "./literal.uff" ValueSourceText;
import "./expression.uff" Expression;

export Pattern;
export Parameters;
export RuleBodyPattern;

rule Pattern<L> =
  | PatternAtom
  | PatternOr<L>
  | PatternAnd<L>
  | PatternPipeline<L>
  | PatternThen<L>
  | PatternProjection<L>
  | PatternVariable<L>
  | PatternNot<L>
  | PatternSkip<L>
  | PatternExcept<L>
  | PatternLookahead<L>
  | PatternRecover<L>
  | PatternQuantifier<L>
  | PatternMaybe<L>
  | PatternInto<L>
  | PatternOver<L>
  | PatternResolve<L>
  | PatternSwitch<L>
  | PatternIncludes<L>
;

rule PatternGroupBody<L> =
  l:L p:Pattern<(ok -> (Inside l 1 1))>
  -> (Bracket l "(" p ")")
;

rule PatternGroup<L> = Fit<PatternGroupBody, L>;

rule OrAlternative<L> =
  | (object & AstKind<"or">) & (g:PatternGroup<L> -> g)
  | Pattern<L>
;

rule AndOperand<L> =
  | (object & AstKind<in["or" "and"]>) & (g:PatternGroup<L> -> g)
  | Pattern<L>
;

rule PipelineStep<L> =
  | (object & AstKind<in["or" "and" "pipeline"]>) & (g:PatternGroup<L> -> g)
  | Pattern<L>
;

rule ThenItem<L> =
  | (object & AstKind<in["or" "and" "pipeline" "then"]>)
    & (g:PatternGroup<L> -> g)
  | Pattern<L>
;

rule PrefixOperand<L> = ThenItem<L>;

# A parameter list: `<a b>` on one line, or each parameter on its own indented
# line with `>` on its own line.
rule ParametersBody<L> =
  l:L
  r:(
    | ((object & AstKind<"end">) -> [])
    | (
      (
        object
        & AstKind<"then">
        & { patterns: [x:ThenItem<(ok -> (Entry l 0))>*] }
      )
      -> x
    )
    | (p:Pattern<(ok -> (Entry l 0))> -> [p])
  )
  -> (List l "<" "" r "" ">")
;

rule Parameters<L> = Fit<ParametersBody, L>;

rule PostfixOperand<L> =
  | (
    object
    & AstKind<
      in[
        "or"
        "and"
        "pipeline"
        "then"
        "variable"
        "not"
        "skip"
        "except"
        "lookahead"
        "recover"
        "quantifier"
        "maybe"
      ]
    >
  )
    & (g:PatternGroup<L> -> g)
  | Pattern<L>
;

rule PatternOrRest<L> =
  l:L c:Lead<L>* p:OrAlternative<(ok -> (Next l 2))>
  -> (join [(Sep l " | " "") ...c (when l.flat "" "| ") p] "")
;

# An alternation's items: the comments before its first alternative, its
# alternatives, and the comments after its last. Only comments keep a single
# alternative from collapsing. With comments before it, it is written by `B`,
# keeping its `|` so that uncommenting an alternative above it keeps both
# alternatives; with comments only after it, by `M`, without `|`.
rule PatternOrItems<L, M, B> =
  | (
    l:L
    (
      object
      & AstKind<"or">
      & {
        patterns: [
          c:Lead<L>*
          f:OrAlternative<(ok -> (Shift l (when l.flat 0 2)))>
          r:PatternOrRest<L>+
          t:Trail<L>*
        ]
      }
    )
    -> (join [...c (when l.flat "" "| ") f ...r ...t] "")
  )
  | (
    l:L (object & AstKind<"or"> & { patterns: [c:Lead<L>+ f:B<L> t:Trail<L>*] })
    -> (join [...c f ...t] "")
  )
  | (
    l:L (object & AstKind<"or"> & { patterns: [f:M<L> t:Trail<L>+] })
    -> (join [f ...t] "")
  )
;

# Comments before the first alternative start on a line of their own.
rule PatternOrLayout<L, M, B> =
  | l:L
    (
      object
      & AstKind<"or">
      & { patterns: [(object & AstKind<"comment">) any*] }
    )
    & (
      b:PatternOrItems<(ok -> (LineStart l)), M, B>
      -> (join [(LineBreak l) b] "")
    )
  | PatternOrItems<L, M, B>
;

rule OrBarred<L> =
  l:L p:OrAlternative<(ok -> (Shift l 2))>
  -> (join ["| " p] "")
;

rule PatternOrBody<L> = PatternOrLayout<L, OrAlternative, OrBarred>;

rule PatternOr<L> = Fit<PatternOrBody, L>;

# A rule's body. An alternation or pipeline is never written on one line, so a
# rule whose body is one always breaks, with each alternative or step on its own
# line.
rule RuleBodyPattern<L> =
  | (object & AstKind<"or">)
    & (
      l:L
      ((ok -> l.flat) |> false)
      p:PatternOrLayout<L, RuleBodyMember, RuleBodyBarred>
      -> p
    )
  | (object & AstKind<"pipeline">)
    & (l:L ((ok -> l.flat) |> false) p:PatternPipelineBody<L> -> p)
  | (not (object & AstKind<in["or" "pipeline"]>) p:Pattern<L> -> p)
;

# The single alternative of a rule body's alternation keeps its rule-body form;
# a pipeline leads with `|>` in place of `|`.
rule RuleBodyMember<L> =
  | (object & AstKind<"or">) & (g:PatternGroup<L> -> g)
  | RuleBodyPattern<L>
;

rule RuleBodyBarred<L> =
  | (object & AstKind<"pipeline">) & RuleBodyPattern<L>
  | OrBarred<L>
;

rule PatternAndRest<L> =
  l:L c:Lead<L>* p:AndOperand<(ok -> (Next l 2))>
  -> (join [(Sep l " & " "") ...c (when l.flat "" "& ") p] "")
;

rule PatternAndBody<L> =
  l:L
  (
    object
    & AstKind<"and">
    & { patterns: [f:AndOperand<L> r:PatternAndRest<L>*] }
  )
  -> (join [f ...r] "")
;

rule PatternAnd<L> = Fit<PatternAndBody, L>;

rule PatternPipelineRest<L> =
  l:L c:Lead<L>* p:PipelineStep<(ok -> (Next l 3))>
  -> (join [(Sep l " |> " "") ...c (when l.flat "" "|> ") p] "")
;

rule PatternPipelineBody<L> =
  l:L
  (
    object
    & AstKind<"pipeline">
    & {
      steps: [
        f:PipelineStep<(ok -> (Shift l (when l.flat 0 3)))>
        r:PatternPipelineRest<L>*
      ]
    }
  )
  -> (join [(when l.flat "" "|> ") f ...r] "")
;

rule PatternPipeline<L> = Fit<PatternPipelineBody, L>;

rule PatternThenRest<L> =
  l:L c:Lead<L>* p:ThenItem<(ok -> (Next l 0))>
  -> (join [(Sep l " " "") ...c p] "")
;

rule PatternThenBody<L> =
  l:L
  (
    object
    & AstKind<"then">
    & { patterns: [f:ThenItem<L> r:PatternThenRest<L>*] }
  )
  -> (join [f ...r] "")
;

rule PatternThen<L> = Fit<PatternThenBody, L>;

rule PatternProjectionBody<L> =
  l:L
  (
    object
    & AstKind<"projection">
    & {
      pattern: AndOperand<(ok -> (Inside l 1 1))> as p,
      expression: Expression<(ok -> (Shift (Inside l 1 1) 3))> as e
    }
  )
  -> (Bracket
    l
    "("
    (join [p (when l.flat " -> " (join ["\n" (Indent l.i) "-> "] "")) e] "")
    ")"
  )
;

rule PatternProjection<L> = Fit<PatternProjectionBody, L>;

rule PatternVariable<L> =
  l:L
  (
    object
    & AstKind<"variable">
    & {
      name: string as n,
      pattern: PrefixOperand<(ok -> (Shift l (add (length n) 1)))> as p
    }
  )
  -> (join [n ":" p] "")
;

rule PatternNot<L> =
  l:L
  (
    object
    & AstKind<"not">
    & { pattern: PrefixOperand<(ok -> (Shift l 4))> as p }
  )
  -> (join ["not " p] "")
;

rule PatternSkip<L> =
  l:L
  (
    object
    & AstKind<"skip">
    & { pattern: PrefixOperand<(ok -> (Shift l 5))> as p }
  )
  -> (join ["skip " p] "")
;

rule PatternExcept<L> =
  l:L
  (
    object
    & AstKind<"except">
    & { pattern: PrefixOperand<(ok -> (Shift l 7))> as p }
  )
  -> (join ["except " p] "")
;

rule PatternLookahead<L> =
  l:L
  (
    object
    & AstKind<"lookahead">
    & { pattern: PrefixOperand<(ok -> (Shift l 10))> as p }
  )
  -> (join ["lookahead " p] "")
;

# `ope P sneak by until T` desugars to this quantifier, so it is written back as
# `until T`.
rule SneakByUntil<L> =
  l:L
  (
    object
    & AstKind<"quantifier">
    & {
      min: { value: 1 },
      max: undefined,
      pattern: {
        patterns: [
          ((object -> _.pattern) |> t:PrefixOperand<(ok -> (Shift l 6))>) any
        ]
      }
    }
  )
  -> (join ["until " t] "")
;

rule SneakBy<L> =
  | SneakByUntil<L>
  | PrefixOperand<L>
;

rule PatternRecoverBody<L> =
  l:L
  (
    object
    & AstKind<"recover">
    & {
      pattern: PrefixOperand<(ok -> (Shift l 4))> as p,
      skip: SneakBy<(ok -> (Next l 9))> as s
    }
  )
  -> (join ["ope " p (Sep l " sneak by " "sneak by ") s] "")
;

rule PatternRecover<L> = Fit<PatternRecoverBody, L>;

rule Bound =
  | (undefined -> "")
  | ValueSourceText
;

func QuantifierSuffix<min:string max:string> =
  (when
    (eq max "")
    (when (eq min "") "*" (when (eq min "1") "+" (join ["*" min] "")))
    (when (eq min "0") (join ["*.." max] "") (join ["*" min ".." max] ""))
  )
;

rule PatternQuantifier<L> =
  l:L
  (
    object
    & AstKind<"quantifier">
    & {
      min: Bound as a,
      max: Bound as b,
      pattern: PostfixOperand<
        (ok -> (Suffix l (length (QuantifierSuffix a b))))
      > as p
    }
  )
  -> (join [p (QuantifierSuffix a b)] "")
;

rule PatternMaybe<L> =
  l:L
  (
    object
    & AstKind<"maybe">
    & { pattern: PostfixOperand<(ok -> (Suffix l 1))> as p }
  )
  -> (join [p "?"] "")
;

rule PatternIntoBody<L> =
  l:L
  (object & AstKind<"into"> & { pattern: Pattern<(ok -> (Inside l 1 1))> as p })
  -> (Bracket l "[" p "]")
;

rule PatternInto<L> = Fit<PatternIntoBody, L>;

# `label: pattern`, or `label:` when the pattern starts on the next line.
func Labeled<label:string pattern:string> =
  (join [label (when (eq (at pattern 0) "\n") ":" ": ") pattern] "")
;

rule PatternOverEntryBare<L> =
  l:L
  (
    array
    & [
      n:string
      (
        object
        & AstKind<"variable">
        & { name: $n, pattern: object & AstKind<"any"> }
      )
    ]
  )
  -> n
;

rule PatternOverEntryTypedGroup<L> =
  l:L
  (
    array
    & [
      n:string
      (
        object
        & AstKind<"variable">
        & {
          name: $n,
          pattern: (object & AstKind<"variable">)
            & p:Pattern<(ok -> (Shift l (add (length n) 4)))>
        }
      )
    ]
  )
  -> (Labeled n (join ["(" p ")"] ""))
;

rule PatternOverEntryTyped<L> =
  l:L
  (
    array
    & [
      n:string
      (
        object
        & AstKind<"variable">
        & {
          name: $n,
          pattern: Pattern<(ok -> (Shift l (add (length n) 2)))> as p
        }
      )
    ]
  )
  -> (Labeled n p)
;

rule PatternOverEntryBareAlias<L> =
  l:L
  (
    array
    & [
      n:string
      (
        object
        & AstKind<"variable">
        & { name: string as b, pattern: object & AstKind<"any"> }
      )
    ]
  )
  -> (join [n " as " b] "")
;

rule PatternOverEntryTypedAlias<L> =
  l:L
  (
    array
    & [
      n:string
      (
        object
        & AstKind<"variable">
        & {
          name: string as b,
          pattern: Pattern<(ok -> (Shift l (add (length n) 2)))> as p
        }
      )
    ]
  )
  -> (join [(Labeled n p) " as " b] "")
;

rule PatternOverEntry<L> =
  | PatternOverEntryBare<L>
  | PatternOverEntryTypedGroup<L>
  | PatternOverEntryTyped<L>
  | PatternOverEntryBareAlias<L>
  | PatternOverEntryTypedAlias<L>
;

rule PatternOverBody<L> =
  l:L
  (object & AstKind<"over"> & { keys: object as k })
  e:((ok -> [...k]) |> [x:PatternOverEntry<(ok -> (Entry l 1))>*] -> x)
  -> (List l "\{" " " e "," "}")
;

rule PatternOver<L> = Fit<PatternOverBody, L>;

rule ReservedName =
  in[
    "and"
    "any"
    "array"
    "bigint"
    "boolean"
    "date"
    "default"
    "end"
    "error"
    "except"
    "fail"
    "false"
    "function"
    "in"
    "includes"
    "into"
    "lookahead"
    "maybe"
    "not"
    "null"
    "number"
    "object"
    "ok"
    "ope"
    "or"
    "over"
    "pipeline"
    "quantifier"
    "set"
    "skip"
    "sneak"
    "string"
    "switch"
    "symbol"
    "true"
    "undefined"
    "until"
    "variable"
  ]
;

rule ResolveName =
  | (n:ReservedName -> (join ["@" n] ""))
  | string
;

rule PatternResolveBody<L> =
  l:L
  (
    object
    & AstKind<"resolve">
    & {
      targetKind: "reference",
      name: ResolveName as n,
      args: [a:Pattern<(ok -> (Entry l 1))>*]
    }
  )
  -> (List l (join [n "<"] "") "" a "," ">")
;

rule PatternResolve<L> =
  | (
    (
      object
      & AstKind<"resolve">
      & { targetKind: "reference", name: ResolveName as n, args: [end] }
    )
    -> n
  )
  | Fit<PatternResolveBody, L>
;

rule SwitchKey =
  | (
    (object & AstKind<"values"> & { values: [v:ValueSourceText*] })
    -> (join v ", ")
  )
  | (
    (object & AstKind<"characterClass"> & { characterClass: string as c })
    -> (join ["\\c" c] "")
  )
;

rule SwitchCase<L> =
  l:L
  (
    object
    & {
      key: SwitchKey as k,
      pattern: Pattern<(ok -> (Shift l (add (length k) 2)))> as p
    }
  )
  -> (Labeled k p)
;

rule SwitchDefault<L> =
  | (undefined -> [])
  | (l:L p:Pattern<(ok -> (Shift l 9))> -> [(Labeled "default" p)])
;

rule PatternSwitchBody<L> =
  l:L
  (
    object
    & AstKind<"switch">
    & {
      cases: [c:SwitchCase<(ok -> (Entry l 1))>*],
      default: SwitchDefault<(ok -> (Entry l 1))> as d
    }
  )
  -> (List l "switch \{" " " (flat [c d]) "," "}")
;

rule PatternSwitch<L> = Fit<PatternSwitchBody, L>;

rule PatternAtom =
  | ((object & AstKind<"any">) -> "any")
  | ((object & AstKind<"end">) -> "end")
  | ((object & AstKind<"ok">) -> "ok")
  | ((object & AstKind<"fail">) -> "fail")
  | ((object & AstKind<"equal"> & { value: ValueSourceText as v }) -> v)
  | ((object & AstKind<"type"> & { type: string as t }) -> t)
  | (
    (object & AstKind<"character"> & { characterClass: string as c })
    -> (join ["\\c" c] "")
  )
  | (
    (object & AstKind<"between"> & { left: Bound as a, right: Bound as b })
    -> (join [a ".." b] "")
  )
;

rule PatternIncludesBody<L> =
  l:L (object & AstKind<"includes"> & { values: [v:ValueSourceText*] })
  -> (List l "in[" "" v "" "]")
;

rule PatternIncludes<L> = Fit<PatternIncludesBody, L>;
