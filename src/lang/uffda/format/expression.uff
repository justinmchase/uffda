# Formats expressions. `Expression<L>` takes an expression node and a layout
# (see `layout.uff`) and produces its source text. Comments among a list's items
# are written on their own lines (see `comment.uff`).
import "./layout.uff"
  Fit
  AstKind
  Shift
  After
  Suffix
  Entry
  List
  Call
  HugHead
  HugFits
  Flat
  NotLast
  Indent
;
import "./comment.uff" CommentAt Commented Trailed;
import "./literal.uff" ExpressionStringText NumberText;
import "./pattern.uff" Parameters;

export rule Expression<L> =
  | ExpressionReference
  | ExpressionNumber
  | ExpressionBoolean
  | ExpressionValue
  | ExpressionString
  | ExpressionNot<L>
  | ExpressionMember<L>
  | ExpressionLambda<L>
  | ExpressionArray<L>
  | ExpressionObject<L>
  | ExpressionInvocation<L>
;

rule ExpressionReference =
  object & AstKind<"reference"> & { name: string as n }
  -> n
;

rule ExpressionNumber =
  object & AstKind<"number"> & { value: NumberText as n }
  -> n
;

rule ExpressionBoolean =
  object & AstKind<"boolean"> & { value: boolean as b }
  -> (when b "true" "false")
;

rule ExpressionValue =
  object
  & AstKind<"value">
  & { value: (null -> "null") | (undefined -> "undefined") as v }
  -> v
;

rule ExpressionStringPart =
  | string & ExpressionStringText
  | (e:Expression<(ok -> (Flat))> -> (join ["\{" e "}"] ""))
;

rule ExpressionString =
  object & AstKind<"string"> & { values: [p:ExpressionStringPart*] }
  -> (join ["\"" (join p "") "\""] "")
;

rule ExpressionNot<L> =
  l:L
  (
    object
    & AstKind<"not">
    & { expression: Expression<(ok -> (Shift l 4))> as e }
  )
  -> (join ["not " e] "")
;

rule ExpressionMember<L> =
  l:L
  (
    object
    & AstKind<"member">
    & {
      name: string as n,
      expression: Expression<(ok -> (Suffix l (add (length n) 1)))> as e
    }
  )
  -> (join [e "." n] "")
;

# The body follows `> -> ` on the parameter list's last line.
rule ExpressionLambda<L> =
  l:L
  (
    object
    & AstKind<"lambda">
    & { pattern: Parameters<(ok -> (Suffix l 4))> as p }
  )
  & o:(
    | ((ok -> p) |> [(not "\n" any)* end] -> (Shift l (add (length p) 4)))
    | (ok -> (After l 5))
  )
  & (object & { expression: Expression<(ok -> o)> as e })
  -> (join [p " -> " e] "")
;

rule ExpressionArrayItem<L> =
  l:L
  r:(
    | (
      (
        object
        & AstKind<"arraySpread">
        & { expression: Expression<(ok -> (Shift l 3))> as e }
      )
      -> (join ["..." e] "")
    )
    | (
      (object & AstKind<"arrayElement"> & { expression: Expression<L> as e })
      -> e
    )
  )
  -> r
;

rule ExpressionArrayBody<L> =
  l:L
  (
    object
    & AstKind<"array">
    & {
      expressions: [
        x:Commented<ExpressionArrayItem, (ok -> (Entry l 0))>*
        t:CommentAt<(ok -> (Entry l 0)), (ok -> (Indent l.i))>*
      ]
    }
  )
  -> (List l "[" "" (Trailed x t (Indent l.i)) "" "]")
;

rule ExpressionArray<L> = Fit<ExpressionArrayBody, L>;

rule ExpressionObjectEntry<L> =
  l:L
  r:(
    | (
      (
        object
        & AstKind<"objectKey">
        & {
          name: string as n,
          expression: Expression<(ok -> (Shift l (add (length n) 2)))> as e
        }
      )
      -> (join [n ": " e] "")
    )
    | (
      (
        object
        & AstKind<"objectSpread">
        & { expression: Expression<(ok -> (Shift l 3))> as e }
      )
      -> (join ["..." e] "")
    )
    | (
      (
        object
        & AstKind<"objectComputedKey">
        & {
          keyExpression: Expression<(ok -> (Flat))> as k,
          expression: Expression<(ok -> (Shift l (add (length k) 4)))> as e
        }
      )
      -> (join ["[" k "]: " e] "")
    )
  )
  -> r
;

rule ExpressionObjectBody<L> =
  l:L
  (
    object
    & AstKind<"object">
    & {
      keys: [
        x:Commented<ExpressionObjectEntry, (ok -> (Entry l 1))>*
        t:CommentAt<(ok -> (Entry l 1)), (ok -> (Indent l.i))>*
      ]
    }
  )
  -> (List l "\{" " " (Trailed x t (Indent l.i)) "," "}")
;

rule ExpressionObject<L> = Fit<ExpressionObjectBody, L>;

rule InvocationArgument<L> =
  l:L
  r:(
    | (
      (
        object
        & AstKind<"invocationSpread">
        & { expression: Expression<(ok -> (Shift l 3))> as e }
      )
      -> (join ["..." e] "")
    )
    | Expression<L>
  )
  -> r
;

rule Hugged = object & AstKind<in["object" "array"]>;

# The last argument, when it is an object or array, starts at the end of the
# line holding the callee and the other arguments.
rule InvocationHug<L> =
  l:L
  (
    object
    & AstKind<"invocation">
    & {
      expression: Expression<(ok -> (Flat))> as c,
      args: [
        x:NotLast<InvocationArgument<(ok -> (Flat))>>*
        ((ok -> (HugFits l (HugHead (join ["(" c] "") x))) |> true)
        z:(
          Hugged
          & InvocationArgument<
            (ok -> (Suffix (Shift l (length (HugHead (join ["(" c] "") x))) 1))
          >
        )
      ]
    }
  )
  -> (join [(HugHead (join ["(" c] "") x) z ")"] "")
;

rule InvocationList<L> =
  l:L
  (
    object
    & AstKind<"invocation">
    & {
      expression: Expression<(ok -> (Flat))> as c,
      args: [
        x:Commented<InvocationArgument, (ok -> (Entry l 0))>*
        t:CommentAt<(ok -> (Entry l 0)), (ok -> (Indent l.i))>*
      ]
    }
  )
  -> (Call l (join ["(" c] "") (Trailed x t (Indent l.i)) ")")
;

rule InvocationBody<L> =
  | InvocationHug<L>
  | InvocationList<L>
;

rule ExpressionInvocation<L> = Fit<InvocationBody, L>;
