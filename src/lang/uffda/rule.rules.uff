# Rule declaration syntax: carve pattern/projection token spans, then
# PatternTokens / ExpressionTokens. Nested chunks project with pack+flat
# (depth-1) instead of host Array.flat. Bindings are single-letter (B12). Brace
# tokens project via bindings (B13: `-> "{"` parses as an object).
import "../pattern/pattern.lang.uff" PatternTokens;
import "../expression/expression.lang.uff" ExpressionTokens;
import "./shared.rules.uff"
  IdentifierToken
  RuleKeyword
  DeclarationName
  DeclarationEquals
  DeclarationEnd
  DeclarationBodyEnd
  BodyToken
  DeclarationKeyword
;
import "../editor/editor.uff" Declaration Parameter Documentation;
import "./attribute.rules.uff" AttributeSyntax;

export RulePatternBody;
export RuleProjectionExpression;
export RulePatternToken;
export RuleProjectionToken;
export RulePatternTokenUntilProjection;
export RulePatternBodyBeforeProjection;
export RuleDeclarationSyntax;
export RuleProjectionTail;
export RuleQuotedTokenSequence;

rule RulePatternBody =
  |> RulePatternToken
  |> PatternTokens
;

rule RuleProjectionExpression =
  |> RuleProjectionToken
  |> ExpressionTokens
;

rule RulePatternToken = string;

rule RuleEscapedQuotedTokens = "\\" e:("\"" | "{" | "\\") -> (pack "\\" e);

rule RuleQuotedTokenContent =
  | RuleEscapedQuotedTokens
  | not "\"" & string
;

rule RuleQuotedTokenSequence =
  o:"\"" c:RuleQuotedTokenContent* e:"\""
  -> (flat (pack o (flat c) e))
;

[Documentation {
  description: "The tokens of a rule's projection expression.",
  error: "`->` must be followed by the expression the rule produces, before the `;`."
}]
rule RuleProjectionToken =
  (RuleQuotedTokenSequence | not DeclarationBodyEnd & BodyToken)+
  -> (flat _)
;

rule RulePatternChunkNestedParen =
  o:"(" c:RulePatternChunkNested* e:")"
  -> (flat (pack o (flat c) e))
;

rule RulePatternChunkNestedBracket =
  o:"[" c:RulePatternChunkNested* e:"]"
  -> (flat (pack o (flat c) e))
;

rule RulePatternChunkNestedBrace =
  o:"{" c:RulePatternChunkNested* e:"}"
  -> (flat (pack o (flat c) e))
;

rule RulePatternChunkNested =
  | RuleQuotedTokenSequence
  | RulePatternChunkNestedParen
  | RulePatternChunkNestedBracket
  | RulePatternChunkNestedBrace
  | not ")" & not "]" & not "}" & BodyToken
;

rule RulePatternChunkAtDepth0Paren =
  o:"(" c:RulePatternChunkNested* e:")"
  -> (flat (pack o (flat c) e))
;

rule RulePatternChunkAtDepth0Bracket =
  o:"[" c:RulePatternChunkNested* e:"]"
  -> (flat (pack o (flat c) e))
;

rule RulePatternChunkAtDepth0Brace =
  o:"{" c:RulePatternChunkNested* e:"}"
  -> (flat (pack o (flat c) e))
;

rule RulePatternChunkAtDepth0 =
  | RuleQuotedTokenSequence
  | RulePatternChunkAtDepth0Paren
  | RulePatternChunkAtDepth0Bracket
  | RulePatternChunkAtDepth0Brace
  | not DeclarationBodyEnd & not ("-" ">") & BodyToken
;

[Documentation {
  description: "The tokens of a rule's pattern.",
  error: "A rule needs a pattern after `=`, before its `;` or `->`."
}]
rule RulePatternTokenUntilProjection = RulePatternChunkAtDepth0+ -> (flat _);

rule RulePatternBodyBeforeProjection =
  |> RulePatternTokenUntilProjection
  |> PatternTokens
;

[Parameter]
[Documentation {
  description: "A rule parameter: a rule passed in by the caller.",
  error: "Rule parameters are names separated by `,`, as in `rule R<A, B> = A B;`."
}]
rule RuleParameterName = n:IdentifierToken -> { name: n };

rule RuleParameterNameTail = "," v:RuleParameterName -> v;

rule RuleParameterNameList =
  f:RuleParameterName r:RuleParameterNameTail* ","?
  -> (flat (pack f r))
;

[Documentation {
  description: "The `>` that ends a rule's parameter list.",
  error: "A rule's parameter list ends with `>`: separate the names with `,` and close the list after the last one."
}]
rule RuleParameterListEnd = ">";

rule RuleParameterList =
  "<" p:RuleParameterNameList? RuleParameterListEnd
  -> (flat (coalesce p []))
;

rule RuleProjectionTail = "-" ">" p:RuleProjectionExpression -> p;

[Declaration]
rule RuleDeclarationSyntax =
  a:AttributeSyntax*
  DeclarationKeyword<RuleKeyword>
  n:DeclarationName
  p:RuleParameterList?
  DeclarationEquals
  t:RulePatternBodyBeforeProjection
  j:RuleProjectionTail?
  DeclarationEnd
  -> {
    kind: "rule",
    name: n,
    parameters: (flat (coalesce p [])),
    pattern: t,
    projection: j,
    attributes: a
  }
;
