# UffdaLang pipelines Source → tokens → ModuleBody.
# ModuleBody merges import / export / rule declaration lists; export items may
# already be lists (name lists or inline export+rule packs), so flatten e once.
import "../source/mod.ts" Source;
import "../tokenizer/mod.ts" TokenizerNoWhitespace;
import "./import.rules.uff" ImportDeclarationSyntax;
import "./export.rules.uff" ExportDeclarationSyntax;
import "./rule.rules.uff" RuleDeclarationSyntax;

export UffdaLang;

rule ModuleBody =
  i:ImportDeclarationSyntax*
  e:ExportDeclarationSyntax*
  r:RuleDeclarationSyntax*
  -> { kind: "module", declarations: (flat [i (flat e) r]) };

rule UffdaLang =
  m:(
    Source
    |> [TokenizerNoWhitespace]
    |> [ModuleBody]
  )
  end
  -> m;
