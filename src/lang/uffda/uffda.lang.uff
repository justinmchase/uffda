# UffdaLang pipelines Source → tokens (comments kept) → ModuleBody. ModuleBody
# merges import / export / rule / func lists. Std flat is depth-1, and each
# ExportDeclarationSyntax value may already be a list (name list or inline
# export+rule/func pack), so flatten e before concatenating with i and d.
# `(flat [i e d])` alone would leave those export sublists nested.
import "../source/mod.uff" Source;
import "../tokenizer/mod.uff" TokenizerNoWhitespaceWithComments;
import "../comment/mod.uff" CommentBlock;
import "../comment/toggle.uff" ToggleHashComment;
import "./import.rules.uff" ImportDeclarationSyntax;
import "./export.rules.uff" ExportDeclarationSyntax;
import "./rule.rules.uff" RuleDeclarationSyntax RuleQuotedTokenSequence;
import "./func.rules.uff" FuncDeclarationSyntax;
import "./decorator.rules.uff" DecoratorDeclarationSyntax;
import "./shared.rules.uff" ReservedKeywordToken ImportKeyword ExportKeyword;
import "./format/mod.uff" UffdaFormat;
import "../editor/editor.uff" Formatter ToggleComment;

export UffdaLang;

# `Language` records this grammar's own editor-facing facts (file extension and
# display name) directly on its entry rule's metadata, so tooling (see
# `src/cli/language_metadata.ts`) can derive an editor's language configuration
# from the grammar itself instead of a hand-maintained, per-language static
# file. `c` is a single object literal so any consumer may freely add further
# properties (for example a future `description` or `wordPattern`) without
# changing the decorator's shape.
decorator Language<c:any> = c;

rule ModuleDeclarationSyntax =
  | FuncDeclarationSyntax
  | RuleDeclarationSyntax
  | DecoratorDeclarationSyntax
;

# Each declaration list is a recovery point. A broken declaration is skipped
# through its `;`, stopping early before a reserved keyword so a missing `;`
# does not swallow the next declaration. Import and export recoveries must start
# with their own keyword, so neither list pre-empts a later one.
rule DeclarationStop =
  | ";"
  | ReservedKeywordToken
;

rule DeclarationRest =
  (RuleQuotedTokenSequence | not DeclarationStop any)* ";"?
;

rule ImportRecovery = ImportKeyword DeclarationRest;

rule ExportRecovery = ExportKeyword DeclarationRest;

rule DeclarationRecovery =
  | ";"
  | (RuleQuotedTokenSequence | any) DeclarationRest
;

# The fence parser for comments: fences tagged `uffda` are Uffda modules. Every
# other tag (apart from untagged and `text` fences, which the comment grammar
# keeps as written) fails, so it is a syntax error.
rule UffdaFence = object & { language: "uffda", code: m:UffdaLang } -> m;

rule UffdaComment = CommentBlock<UffdaFence>;

# Each run of consecutive comments becomes one comment node before the module
# grammar runs. A run that starts after code on the same line is wrapped as a
# `lineEndComment`, which only the module body accepts: inside a declaration,
# comments must be on their own lines.
rule LineEndMarker = object & { kind: "lineEnd" };

rule CommentNode =
  | (LineEndMarker c:UffdaComment -> { kind: "lineEndComment", comment: c })
  | UffdaComment
;

rule CommentNodes = i:(string | CommentNode | any)* end -> i;

rule ModuleComment =
  | object & { kind: "comment", blocks: array }
  | object & ({ kind: "lineEndComment", comment: c:any } -> c)
;

# Between top-level declarations, each list admits `ModuleComment` ahead of its
# declarations, in source order in `declarations`. Inside a declaration, the
# declaration's own grammar decides where a comment may appear.
rule ModuleBody =
  i:(ModuleComment | ope ImportDeclarationSyntax sneak by skip ImportRecovery)*
  e:(ModuleComment | ope ExportDeclarationSyntax sneak by skip ExportRecovery)*
  d:(
    | ModuleComment
    | ope ModuleDeclarationSyntax sneak by skip DeclarationRecovery
  )*
  -> { kind: "module", declarations: (flat [i (flat e) d]) }
;

[Language { ext: ".uff", name: "Uffda" }]
[Formatter UffdaFormat]
[ToggleComment ToggleHashComment]
rule UffdaLang =
  m:(
    |> Source
    |> [TokenizerNoWhitespaceWithComments]
    |> [CommentNodes]
    |> [ModuleBody]
  )
  end
  -> m
;
