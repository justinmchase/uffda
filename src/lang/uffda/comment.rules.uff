# Comment syntax: a `#` line comment between top-level declarations.
# The module grammar reads the comment-preserving token view, where each
# comment is the tokenizer's own `{ kind: "comment", text }` value among plain
# word/punctuation strings. `object &` guards the key match, since `over` on a
# string item is a type error rather than a failure.
export CommentSyntax;

rule CommentSyntax =
  object & { kind: "comment", text: t:string }
  -> { kind: "comment", text: t };
