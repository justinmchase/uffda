# Func declaration syntax: expression body only (no rule-style ->). Parameter
# lists are PatternLang patterns in angle brackets, e.g. `<a:number b:string>`
# or `<a:any*>`. The list is one pattern (typically Then). Omitted or empty `<>`
# means End (no arguments). Variable bindings are single-letter (B12). The
# `<...>` capture-and-reparse mechanism itself is shared with inline lambda
# expressions; see pattern/parameter_list.uff.
import "../expression/expression.lang.uff" ExpressionTokens;
import "../pattern/parameter_list.uff" ParameterList;
import "./shared.rules.uff"
  FuncKeyword
  DeclarationName
  DeclarationEquals
  DeclarationEnd
  DeclarationBodyEnd
  BodyToken
  DeclarationKeyword
;
import "../editor/editor.uff" Declaration Documentation;
import "./attribute.rules.uff" AttributeSyntax;

export FuncDeclarationSyntax;

export rule FuncExpressionBody =
  |> FuncExpressionToken
  |> ExpressionTokens
;

rule FuncEscapedQuotedTokens = "\\" e:("\"" | "{" | "\\") -> (pack "\\" e);

rule FuncQuotedTokenContent =
  | FuncEscapedQuotedTokens
  | not "\"" & string
;

rule FuncQuotedTokenSequence =
  o:"\"" c:FuncQuotedTokenContent* e:"\""
  -> (flat (pack o (flat c) e))
;

[Documentation {
  description: "The tokens of a func or decorator body.",
  error: "A func or decorator needs an expression after `=`, before its `;`."
}]
rule FuncExpressionToken =
  (FuncQuotedTokenSequence | not DeclarationBodyEnd & BodyToken)+
  -> (flat _)
;

[Declaration]
rule FuncDeclarationSyntax =
  a:AttributeSyntax*
  DeclarationKeyword<FuncKeyword>
  n:DeclarationName
  p:ParameterList?
  DeclarationEquals
  e:FuncExpressionBody
  DeclarationEnd
  -> {
    kind: "func",
    name: n,
    pattern: (coalesce p { kind: "end" }),
    expression: e,
    attributes: a
  }
;
