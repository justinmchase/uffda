# Shared Uffda tokens: identifiers excluding reserved keywords, plus the
# reserved keyword tokens themselves, each decorated with [Keyword] (see
# ../editor/editor.uff) so editor tooling classifies their matched spans as
# keywords without a separately maintained rule-name-to-role mapping.
import "../common/identifier.uff" IdToken;
import "../editor/editor.uff" Keyword;

export IdentifierToken;
export ReservedKeywordToken;
export ImportKeyword;
export ExportKeyword;
export RuleKeyword;
export FuncKeyword;
export DecoratorKeyword;
export DeclarationBodyEnd;

[Keyword]
rule ImportKeyword = "import" -> "import";

[Keyword]
rule ExportKeyword = "export" -> "export";

[Keyword]
rule RuleKeyword = "rule" -> "rule";

[Keyword]
rule FuncKeyword = "func" -> "func";

[Keyword]
rule DecoratorKeyword = "decorator" -> "decorator";

rule ReservedKeywordToken =
  ImportKeyword | ExportKeyword | RuleKeyword | FuncKeyword | DecoratorKeyword
;

rule IdentifierToken = not ReservedKeywordToken & IdToken;

# The head of a rule, func, or decorator declaration, through its `=`.
rule DeclarationHead =
  (RuleKeyword | FuncKeyword | DecoratorKeyword)
  IdentifierToken
  (not (";" | "=") any)*
  "="
;

# Where a declaration body's tokens end: its `;`, or the head of the next
# declaration when the `;` is missing. `=` never appears in a pattern or
# expression, so a body never contains a declaration head.
rule DeclarationBodyEnd = ";" | DeclarationHead;
