# Export declaration syntax: `export rule …`, `export func …`, or `export Name*;`.
# Per-item ExportName projection avoids map/lambda (pattern idioms).
# Inline export packs [export-decl, rule/func-decl] via std pack.
# Variable bindings are single-letter (published CLI PatternLang).
import "./shared.rules.uff" IdentifierToken;
import "./rule.rules.uff" RuleDeclarationSyntax;
import "./func.rules.uff" FuncDeclarationSyntax;

export ExportDeclarationSyntax;
export ExportNameList;

rule ExportName =
  n:IdentifierToken
  -> { kind: "export", name: n };

rule ExportNameList =
  ExportName
  ExportName*
  -> (flat _);

rule InlineExportedRuleDeclarationSyntax =
  "export"
  r:RuleDeclarationSyntax
  -> (pack { kind: "export", name: r.name } r);

rule InlineExportedFuncDeclarationSyntax =
  "export"
  f:FuncDeclarationSyntax
  -> (pack { kind: "export", name: f.name } f);

rule StandaloneExportDeclarationSyntax =
  "export"
  n:ExportNameList
  ";"
  -> n;

rule ExportDeclarationSyntax =
  | InlineExportedRuleDeclarationSyntax
  | InlineExportedFuncDeclarationSyntax
  | StandaloneExportDeclarationSyntax
  ;
