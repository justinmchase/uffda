# DecoratorDeclarationSyntax matches `decorator Name<params> = expr;`: a
# top-level declaration parallel to `func`, but living in its own namespace
# (never resolvable as an ordinary reference/invocation, never invocable via
# `func`-style call syntax). Applied to a rule/func/decorator via `[Name arg…]`
# attribute syntax, see attribute.rules.uff. See
# languages/uffda-syntax/decorator-declarations.spec.md. Reuses
# FuncExpressionBody for the expression body (identical tokenizing/parsing
# needs). Variable bindings are single-letter (published CLI PatternLang).
import "../pattern/parameter_list.uff" ParameterList;
import "./shared.rules.uff"
  DecoratorKeyword
  DeclarationName
  DeclarationEquals
  DeclarationEnd
  DeclarationKeyword
;
import "../editor/editor.uff" Declaration;
import "./func.rules.uff" FuncExpressionBody;
import "./attribute.rules.uff" AttributeSyntax;

export [Declaration]
rule DecoratorDeclarationSyntax =
  a:AttributeSyntax*
  DeclarationKeyword<DecoratorKeyword>
  n:DeclarationName
  p:ParameterList?
  DeclarationEquals
  e:FuncExpressionBody
  DeclarationEnd
  -> {
    kind: "decorator",
    name: n,
    pattern: (coalesce p { kind: "end" }),
    expression: e,
    attributes: a
  }
;
