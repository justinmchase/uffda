# AttributeSyntax matches `[Name]` / `[Name arg1 arg2]`: a declaration-time
# annotation prefix on rule/func declarations, resolved against `decorator`
# declarations exclusively (not ordinary funcs) at resolve time. See
# languages/uffda-syntax/declaration-attributes.spec.md. Variable bindings are
# single-letter (published CLI PatternLang).
import "../tokenizer/token.uff" Token;
import "../expression/primary.uff" Primary;
import "../expression/reference.uff" Reference;
import "../editor/editor.uff" NameReference Documentation;

export AttributeSyntax;

rule AttributeOpenBracket = "[" -> "[";

[Documentation {
  description: "The `]` that ends an attribute.",
  error: "Expected `]` here to close the attribute, or another argument, as in `[Foo 1]`."
}]
rule AttributeCloseBracket = "]" -> "]";

[NameReference { kinds: ["decorator"] }]
[Documentation {
  description: "The decorator an attribute applies.",
  error: "An attribute starts with the name of a decorator, as in `[Foo]`."
}]
rule AttributeName = Token<Reference> -> _;

rule AttributeArgument = Token<Primary> -> _;

rule AttributeSyntax =
  Token<AttributeOpenBracket>
  n:AttributeName
  a:AttributeArgument*
  Token<AttributeCloseBracket>
  -> { kind: "attribute", name: n.name, args: a }
;
