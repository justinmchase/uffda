# Tokenizer: structured tokens with comment/string trivia, then semantic views.
#
# Declare the `"\\"` pattern before other quoted rule bodies so the multi-rule
# quote scanner (B15) does not break on later backslash literals.
import "../common/characters/mod.uff" Combining Connecting Digit Formatting Letter Whitespace;
import "./token.uff" Token;

export Token;
export TokenizerNoWhitespace;
export rule Tokenizer =
  Tokens*
  -> (flat _ 2)
  ;

rule SlashPunctuationToken =
  b:"\\"
  -> { kind: "punctuation", text: b };

rule EscapeFollower =
  | Whitespace
  | "\n"
  | Letter
  | Connecting
  | Combining
  | Digit
  | Formatting
  | string
  ;

rule EscapeCharPunctuationToken =
  e:EscapeFollower
  -> { kind: "punctuation", text: e };

rule EscapeTokens =
  SlashPunctuationToken EscapeCharPunctuationToken;

rule WhitespaceToken =
  Whitespace+
  -> { kind: "whitespace", text: (join (flat _) "") };

rule NewLineToken =
  "\n"
  -> { kind: "newline", text: _ };

rule WordToken =
  (Letter | Connecting | Combining | Digit | Formatting)+
  -> { kind: "word", text: (join (flat _) "") };

rule PunctuationToken =
  string
  -> { kind: "punctuation", text: _ };

rule DQuoteToken =
  "\""
  -> { kind: "punctuation", text: _ };

rule CommentToken =
  "#" (except "\n")*
  -> { kind: "comment", text: (join (flat _) "") };

rule StringPunctuationToken =
  (not "\"") & string
  -> { kind: "punctuation", text: _ };

rule StringInterior =
  | EscapeTokens
  | WhitespaceToken
  | NewLineToken
  | WordToken
  | StringPunctuationToken
  ;

rule QuotedStringTokens =
  o:DQuoteToken
  i:StringInterior*
  c:DQuoteToken?
  -> (flat [o i (coalesce c [])] 2);

rule Tokens =
  | QuotedStringTokens
  | CommentToken
  | WhitespaceToken
  | NewLineToken
  | WordToken
  | PunctuationToken
  ;

# `semantic_no_whitespace_texts` is module-local: it is only needed here to
# project tokens down to word/punctuation text, omitting whitespace and
# comments (#124).
func IsWordOrPunctuation<{kind: k:string}> =
  (has ["word" "punctuation"] k);

func TokenText<{text: t:string}> = t;

func semantic_no_whitespace_texts<tokens:array> =
  (map (filter tokens IsWordOrPunctuation) TokenText);

rule TokenizerNoWhitespace =
  Tokenizer
  -> (semantic_no_whitespace_texts _)
  ;
