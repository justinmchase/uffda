# Tokenizer: structured tokens with comment/string trivia, then semantic views.
#
# Declare the `"\\"` pattern before other quoted rule bodies so the multi-rule
# quote scanner (B15) does not break on later backslash literals.
import "../common/characters/mod.uff" Combining Connecting Digit Formatting Letter Whitespace;
import "./token.uff" Token;

export Token;
export TokenizerNoWhitespace;
export rule Tokenizer =
  Tokens*
  -> (flat _ 2)
  ;

rule SlashPunctuationToken =
  b:"\\"
  -> { kind: "punctuation", text: b };

# Dispatched with `switch` (#158 Stage 2): the leading character after `\`
# uniquely determines which alternative applies, so a single committed-choice
# character-class check replaces trying each alternative in turn.
rule EscapeFollower =
  switch {
    \cZs: Whitespace,
    \cZl: Whitespace,
    \cZp: Whitespace,
    "\t": Whitespace,
    "\n": "\n",
    \cL: Letter,
    \cNl: Letter,
    \cPc: Connecting,
    \cMn: Combining,
    \cMe: Combining,
    \cMc: Combining,
    \cNd: Digit,
    \cCf: Formatting,
    default: string
  };

rule EscapeCharPunctuationToken =
  e:EscapeFollower
  -> { kind: "punctuation", text: e };

rule EscapeTokens =
  SlashPunctuationToken EscapeCharPunctuationToken;

rule WhitespaceToken =
  Whitespace+
  -> { kind: "whitespace", text: (join (flat _) "") };

rule NewLineToken =
  "\n"
  -> { kind: "newline", text: _ };


# `WordChar` is a hot per-character dispatch inside `WordToken`'s `+` loop
# (#158 Stage 2): each declared character class maps directly to its
# matcher, so the loop no longer trials up to 5 alternatives per character.
rule WordChar =
  switch {
    \cL: Letter,
    \cNl: Letter,
    \cPc: Connecting,
    \cMn: Combining,
    \cMe: Combining,
    \cMc: Combining,
    \cNd: Digit,
    \cCf: Formatting
  };

rule WordToken =
  WordChar+
  -> { kind: "word", text: (join (flat _) "") };

rule PunctuationToken =
  string
  -> { kind: "punctuation", text: _ };

rule DQuoteToken =
  "\""
  -> { kind: "punctuation", text: _ };

rule CommentToken =
  "#" (except "\n")*
  -> { kind: "comment", text: (join (flat _) "") };

rule StringPunctuationToken =
  (not "\"") & string
  -> { kind: "punctuation", text: _ };

# `StringInterior`'s per-character dispatch inside quoted strings (#158
# Stage 2): committed-choice `switch` replaces trying each alternative
# in turn per character; a closing `"` (not any declared key) falls to
# `default`, matching the original last-alternative failure exactly.
rule StringInterior =
  switch {
    "\\": EscapeTokens,
    \cZs: WhitespaceToken,
    \cZl: WhitespaceToken,
    \cZp: WhitespaceToken,
    "\t": WhitespaceToken,
    "\n": NewLineToken,
    \cL: WordToken,
    \cNl: WordToken,
    \cPc: WordToken,
    \cMn: WordToken,
    \cMe: WordToken,
    \cMc: WordToken,
    \cNd: WordToken,
    \cCf: WordToken,
    default: StringPunctuationToken
  };

rule QuotedStringTokens =
  o:DQuoteToken
  i:StringInterior*
  c:DQuoteToken?
  -> (flat [o i (coalesce c [])] 2);

# `Tokens`'s per-token dispatch (#158 Stage 2, the original motivating
# case): the leading character of each token kind is disjoint, so `switch`
# replaces the 6-way ordered-choice trial with one committed-choice check.
# `default` is the exact equivalent of the original last-alternative
# fallback (`PunctuationToken` matches any remaining single character).
rule Tokens =
  switch {
    "\"": QuotedStringTokens,
    "#": CommentToken,
    \cZs: WhitespaceToken,
    \cZl: WhitespaceToken,
    \cZp: WhitespaceToken,
    "\t": WhitespaceToken,
    "\n": NewLineToken,
    \cL: WordToken,
    \cNl: WordToken,
    \cPc: WordToken,
    \cMn: WordToken,
    \cMe: WordToken,
    \cMc: WordToken,
    \cNd: WordToken,
    \cCf: WordToken,
    default: PunctuationToken
  };

# `semantic_no_whitespace_texts` is module-local: it is only needed here to
# project tokens down to word/punctuation text, omitting whitespace and
# comments (#124).
func IsWordOrPunctuation<{kind: k:string}> =
  (has ["word" "punctuation"] k);

func TokenText<{text: t:string}> = t;

func semantic_no_whitespace_texts<tokens:array> =
  (map (filter tokens IsWordOrPunctuation) TokenText);

rule TokenizerNoWhitespace =
  Tokenizer
  -> (semantic_no_whitespace_texts _)
  ;
