# TokenizerLang: Source → structured tokens → semantic texts (comments omitted).
import "../source/mod.uff" Source;
import "./mod.uff" Tokenizer;

export rule TokenizerLang =
  s:Source
  |> [Tokenizer]
  -> {
    source: s,
    tokens: (semantic_texts _)
  };

# `semantic_texts` is module-local: it is only needed here to project tokens
# down to their text, omitting comments (#124).
func IsNotComment<t:{kind:string}> =
  (not (eq t.kind "comment"));

func TokenText<t:{text:string}> = t.text;

func semantic_texts<tokens:array> =
  (map (filter tokens IsNotComment) TokenText);
