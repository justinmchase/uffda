# Identifier matches a Unicode identifier and projects a joined string. IdToken
# matches a string stream item that is a valid Identifier when looked into
# (PatternLang / expression token form). Distinct from Uffda IdentifierToken,
# which also excludes module keywords.
import "./characters/letter.uff" Letter;
import "./characters/digit.uff" Digit;
import "./characters/connecting.uff" Connecting;
import "./characters/combining.uff" Combining;
import "./characters/formatting.uff" Formatting;
import "../editor/editor.uff" Documentation;

export rule Identifier =
  IdentifierStartCharacter IdentifierCharacter*
  -> (join (flat _) "")
;

export rule IdToken = string & [Identifier];

# `@Name` is a global registry symbol whose key is Name. It is not an identifier
# and it does not escape a reserved word: `@func` is the symbol named func.
export rule SymbolToken = "@" n:SymbolName -> n;

[Documentation {
  description: "The identifier that names a `@` symbol.",
  error: "Expected an identifier after `@`, as in `@Name`."
}]
rule SymbolName = IdToken;

rule IdentifierStartCharacter =
  | Letter
  | "_"
;

rule IdentifierCharacter =
  | IdentifierStartCharacter
  | Digit
  | Connecting
  | Combining
  | Formatting
;
