import "../editor/editor.uff" Documentation;

export CommentNode;
export OwnLineComment;

# A comment node: one run of consecutive `#` line comments, already parsed by
# the comment syntax (see ../comment/mod.uff) before a host grammar runs. The
# pattern and expression grammars accept comment nodes only at the positions
# they declare, as members of the list they appear in.
[Documentation {
  description: "A comment on its own line, kept in the syntax tree as a member of the list it appears in."
}]
rule CommentNode =
  | OwnLineComment
  | LineEndComment
;

rule OwnLineComment = object & { kind: "comment", blocks: array };

# A comment after code on the same line. Inside a declaration it is always a
# mistake, so it is matched only to fail just after it, where `CommentAfterCode`
# begins and explains the mistake.
rule LineEndComment = object & { kind: "lineEndComment" } CommentAfterCode;

[Documentation {
  description: "Fails after a comment that follows code on the same line.",
  error: "Comments are part of the syntax: inside a declaration, a comment must be on a line of its own. Code and a comment cannot share a line, so move the comment to the line above or below."
}]
rule CommentAfterCode = fail;
