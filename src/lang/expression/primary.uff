# Primary is the expression leaf alternatives before unary wrapping.
import "./terminal.uff" Terminal;
import "./string.ts" String;
import "./array.uff" Array;
import "./object.uff" Object;
import "./member.ts" Member;
import "./boolean.uff" Boolean;
import "./nullish.uff" Nullish;
import "./sequence.uff" Sequence;

export Primary;

rule Primary =
  | Sequence
  | Array
  | Object
  | Member
  | Boolean
  | Nullish
  | Terminal
  | String
  ;
