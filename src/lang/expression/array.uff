# Array matches `[` … `]` with element/spread initializers and projects an
# ArrayExpression. Variable bindings are single-letter (published CLI
# PatternLang). Comment nodes may appear among the elements, as members of
# `expressions`.
import "../tokenizer/token.uff" Token;
import "./primary.uff" Primary;
import "../common/spread.uff" SpreadMarker;
import "./sequence.uff" ExpressionDelimiter;
import "../common/comment.uff" CommentNode;
import "../editor/editor.uff" Documentation;

export Array;

rule OpenBracket = "[" -> "[";

[Documentation {
  description: "The `]` that ends an array.",
  error: "Expected `]` here to close the array that starts with `[`."
}]
rule CloseBracket = "]" -> "]";

rule ArrayElement = Token<Primary> -> { kind: "arrayElement", expression: _ };

rule ArraySpread =
  SpreadMarker e:Token<Primary>
  -> { kind: "arraySpread", expression: e }
;

rule ArrayInitializer =
  | CommentNode
  | ArraySpread
  | ArrayElement
;

# A stray element token is a recovery point.
rule Array =
  Token<OpenBracket>
  e:(ope ArrayInitializer sneak by skip (not ExpressionDelimiter any))*
  Token<CloseBracket>
  -> { kind: "array", expressions: e }
;
