# Object matches `{` … `}` with key/spread entries and projects an
# ObjectExpression. Variable bindings are single-letter (published CLI
# PatternLang). Comment nodes may appear before each entry and after the last
# one, as members of `keys`.
import "../tokenizer/token.uff" Token;
import "./reference.uff" Reference;
import "./primary.uff" Primary;
import "../common/spread.uff" SpreadMarker;
import "./sequence.uff" ExpressionDelimiter;
import "../common/comment.uff" CommentNode;
import "../editor/editor.uff" Documentation;

export Object;

rule OpenBrace = "{";

[Documentation {
  description: "The `}` that ends an object.",
  error: "Expected `}` here to close the object that starts with `\{`."
}]
rule CloseBrace = "}";

rule OpenBracket = "[" -> "[";

rule CloseBracket = "]" -> "]";

[Documentation {
  description: "The `:` between an object entry's key and its value.",
  error: "Each entry of an object is a key, `:`, and its value, as in `\{ name: n }`."
}]
rule Colon = ":" -> ":";

rule Comma = "," -> ",";

rule ObjectPair =
  k:Token<Reference> Token<Colon> v:Token<Primary>
  -> { kind: "objectKey", name: k.name, expression: v }
;

rule ObjectComputedKey =
  Token<OpenBracket>
  k:Token<Primary>
  Token<CloseBracket>
  Token<Colon>
  v:Token<Primary>
  -> { kind: "objectComputedKey", keyExpression: k, expression: v }
;

rule ObjectSpread =
  SpreadMarker e:Token<Primary>
  -> { kind: "objectSpread", expression: e }
;

rule ObjectEntry =
  | ObjectSpread
  | ObjectComputedKey
  | ObjectPair
;

# A broken entry is a recovery point, skipped up to the next delimiter.
rule RecoverableObjectEntry =
  ope ObjectEntry sneak by skip (not ExpressionDelimiter any)+
;

# What may follow an entry. Anything else after a complete entry is skipped up
# to the next of these, so a stray item costs only itself, not the object.
[Documentation {
  description: "What may follow an object entry.",
  error: "Expected `,` here before the object's next entry, or `}` to close it."
}]
rule ObjectEntryEnd =
  | Token<Comma>
  | Token<CloseBrace>
  | CommentNode
;

rule ObjectEntryRest =
  ope lookahead ObjectEntryEnd sneak by skip (not ExpressionDelimiter any)+
;

rule ObjectItem =
  CommentNode* RecoverableObjectEntry skip ObjectEntryRest
  -> (flat _)
;

rule ObjectPairTail = skip Token<Comma> i:ObjectItem -> i;

rule ObjectPairs = f:ObjectItem r:ObjectPairTail* -> (flat [f (flat r)]);

rule Object =
  Token<OpenBrace> k:ObjectPairs? t:CommentNode* Token<CloseBrace>
  -> { kind: "object", keys: (flat [(coalesce k []) t]) }
;
