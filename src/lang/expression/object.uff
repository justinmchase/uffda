# Object matches `{` … `}` with key/spread entries and projects an
# ObjectExpression. Variable bindings are single-letter (published CLI PatternLang).
import "../tokenizer/token.uff" Token;
import "./reference.uff" Reference;
import "./primary.uff" Primary;
import "../common/spread.uff" SpreadMarker;

export Object;

rule OpenBrace = "{";
rule CloseBrace = "}";
rule OpenBracket = "[" -> "[";
rule CloseBracket = "]" -> "]";
rule Colon = ":" -> ":";
rule Comma = "," -> ",";

rule ObjectPair =
  k:Token<Reference>
  Token<Colon>
  v:Token<Primary>
  -> { kind: "objectKey", name: k.name, expression: v };

rule ObjectComputedKey =
  Token<OpenBracket>
  k:Token<Primary>
  Token<CloseBracket>
  Token<Colon>
  v:Token<Primary>
  -> { kind: "objectComputedKey", keyExpression: k, expression: v };

rule ObjectSpread =
  SpreadMarker
  e:Token<Primary>
  -> { kind: "objectSpread", expression: e };

rule ObjectEntry =
  | ObjectSpread
  | ObjectComputedKey
  | ObjectPair
  ;

rule ObjectPairTail =
  Token<Comma>
  p:ObjectEntry
  -> p;

rule ObjectPairs =
  ObjectEntry
  ObjectPairTail*
  -> (flat _);

rule OptPairs = ObjectPairs?;

rule Object =
  Token<OpenBrace>
  k:OptPairs
  Token<CloseBrace>
  -> { kind: "object", keys: (flat (coalesce k [])) };
