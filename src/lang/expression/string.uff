# String matches quoted literals with escapes and {Primary} interpolations.
# Needs published CLI with B15 (`\\` in multi-rule modules) — 0.1.15+. Variable
# bindings are single-letter (published CLI PatternLang). Project `{` via
# binding (B13: `-> "{"` parses as an object literal).
import "./primary.uff" Primary;
import "../common/characters/mod.uff" NewLine Whitespace;
import "../editor/editor.uff" Documentation;

export String;

rule EscapedCurlyBegin = "\\" c:"{" -> c;

rule EscapedDoubleQuote = "\\" "\"" -> "\"";

rule EscapedBackslash = "\\" "\\" -> "\\";

rule EscapedTab = "\\" "t" -> "\t";

rule EscapedNewline = "\\" "n" -> "\n";

rule EscapedReturn = "\\" "r" -> "\r";

rule EscapedString =
  | EscapedCurlyBegin
  | EscapedDoubleQuote
  | EscapedBackslash
  | EscapedTab
  | EscapedNewline
  | EscapedReturn
;

# Whitespace inside a string reaches this grammar as content tokens; inside an
# interpolation it only separates code tokens, so it is dropped before the code
# is parsed.
rule InterpolationSpace = string & [(Whitespace | NewLine)+];

rule InterpolationCode =
  (
    | (InterpolationSpace -> [])
    | ("{" c:InterpolationCode "}" -> (flat ["\{" c "}"]))
    | ((not "{" & not "}" & string) -> [_])
  )*
  -> (flat _)
;

[Documentation {
  description: "The end of an interpolation's one expression.",
  error: "An interpolation holds one expression and then `}`, as in `\{name}`. Expected `}` here."
}]
rule InterpolationValueEnd = end;

rule InterpolationValue = v:Primary InterpolationValueEnd -> v;

[Documentation {
  description: "The `}` that ends an interpolation in a string.",
  error: "Expected `}` here to close the interpolation that starts with `\{`."
}]
rule InterpolationEnd = "}";

rule StringExpression =
  "{" v:(InterpolationCode |> [InterpolationValue]) InterpolationEnd
  -> v
;

rule StringContent =
  (EscapedString | not "{" & not "\"" & string)+
  -> (join _ "")
;

[Documentation {
  description: "The `\"` that ends a string.",
  error: "This string is missing its closing `\"`."
}]
rule StringEnd = "\"";

rule String =
  "\"" v:(StringExpression | StringContent)* StringEnd
  -> { kind: "string", values: v }
;
